<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Win32" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.HarfBuzz" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageVersion Include="FluentAvaloniaUI" Version="3.0.2" />
    <PackageVersion Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
    <!-- SkiaSharp 4.x is a new major line; Avalonia.Skia 12.1.6 is compiled
         against SkiaSharp 3.119.4, so the renderer stays on that version. -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Windows.SDK.CPP.x64" Version="10.0.28000.2957" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>
</Project>
