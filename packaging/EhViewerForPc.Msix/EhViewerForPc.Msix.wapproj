<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX 打包工程（Windows Application Packaging Project，方案源自 little-fancy-tool-ava）。

  负载 = NativeAOT 发布产物（约 16 MB）：
    PublishAotForMsix  在 DesktopBridge 组装负载（_ConvertItems）之前执行
                       `dotnet publish -p:PublishAot=true` -> artifacts/msix/aot
    InjectAotPayload   在 _ConvertItems 之后：移除入口工程的托管构建负载
                       （TargetPath 带 "EhViewerForPc\" 前缀），把 AOT 产物注入
                       同一子目录（清单生成步骤会把入口应用的 Executable 展开为
                       EhViewerForPc\EhViewerForPc.exe，必须与之对齐；
                       CopyToTargetPath 指向 obj\<platform>\<config>\PackageLayout）。
                       该改写模式与参考工程的 RebaseCliPayloadToPackageRoot 同构。
    NativeAOT 必须走 publish（AOT 代码生成不在 Build 管线中），因此不能通过给
    入口工程设 PublishAot=true 让 WAP 直接收集——Build 产物仍是托管 IL。

  VS 中右键本工程"生成"出包；设为启动项目可 F5 部署并启动打包后的应用。
  命令行构建必须用 VS 自带 MSBuild（DesktopBridge targets 只随 VS 安装）。
-->
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &lt; '15.0'">
    <VisualStudioVersion>15.0</VisualStudioVersion>
  </PropertyGroup>
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|AnyCPU">
      <Configuration>Debug</Configuration>
      <Platform>AnyCPU</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|AnyCPU">
      <Configuration>Release</Configuration>
      <Platform>AnyCPU</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup>
    <WapProjPath Condition="'$(WapProjPath)'==''">$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\</WapProjPath>
  </PropertyGroup>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.props" />
  <PropertyGroup>
    <ProjectGuid>b27c0465-9c92-441e-8ee1-5909bf5ebde9</ProjectGuid>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <!-- Unsigned packages must not request cleanup of a certificate that was never created. -->
    <GenerateTemporaryStoreCertificate>$(AppxPackageSigningEnabled)</GenerateTemporaryStoreCertificate>
    <NoWarn>$(NoWarn);NU1702;NU1701</NoWarn>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
    <GenerateTestArtifacts>true</GenerateTestArtifacts>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <EntryPointProjectUniqueName>..\..\src\EhViewerForPc\EhViewerForPc.csproj</EntryPointProjectUniqueName>
    <!-- VS builds the solution's ordinary app evaluation, not this isolated
         reference. Publish the isolated variant before collecting its outputs. -->
    <WapAlwaysBuildDependentProjects>true</WapAlwaysBuildDependentProjects>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
  <ItemGroup>
    <!-- 通配包含 Assets 下全部 PNG，包括 Square44x44Logo.targetsize-*_altform-unplated /
         lightunplated 无底板图标。缺少无底板变体时任务栏会回退到带底板图标，并用
         清单 BackgroundColor 绘制方形底板（表现为图标外圈黑边）。 -->
    <Content Include="Assets\*.png" />
  </ItemGroup>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.targets" />
  <ItemGroup>
    <!-- 版本由根 Directory.Packages.props（CPM）统一管理，此处不得写显式 Version（NU1008）。 -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\EhViewerForPc\EhViewerForPc.csproj">
      <!-- The IDE built ordinary dependency outputs. This isolated evaluation
           must build its own complete dependency graph, including references.
           其托管构建产物在 InjectAotPayload 中被移除、不进包；保留此引用是为了
           维持 VS 标准的依赖顺序与部署语义。 -->
      <AdditionalProperties>EhViewerMsixBuild=true;BuildingInsideVisualStudio=false;BuildProjectReferences=true</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
  <!-- Restore before DesktopBridge queries deployable content from the isolated app.
       Use a separate evaluation so the publish build loads the new NuGet imports. -->
  <Target Name="RestoreMsixProjectReferences" BeforeTargets="SetProjectReferenceProperties" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="@(ProjectReference)" Targets="Restore" Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=win-x64;SelfContained=true;MSBuildIsRestoring=true" />
  </Target>
  <PropertyGroup>
    <AppProject>$(MSBuildThisFileDirectory)..\..\src\EhViewerForPc\EhViewerForPc.csproj</AppProject>
    <AotPayloadDir>$(MSBuildThisFileDirectory)..\..\artifacts\msix\aot</AotPayloadDir>
    <AotPayloadLayoutRoot>$([System.IO.Path]::Combine($(MSBuildProjectDirectory), 'obj', '$(Platform)', '$(Configuration)', 'PackageLayout'))</AotPayloadLayoutRoot>
    <!-- 入口工程负载在包内的子目录前缀 = 项目名（与 obj/.../PackageLayout 下观察到的
         EhViewerForPc\ 一致）；InjectAotPayload 按此前缀移除托管负载。 -->
    <EntryPayloadPrefix>EhViewerForPc\</EntryPayloadPrefix>
    <PackageCertificateThumbprint>0002A085EDBAA55E2DD16A09CF752756DA371596</PackageCertificateThumbprint>
  </PropertyGroup>
  <!-- AOT 发布：AOT 代码生成只发生在 publish 管线，必须在 _ConvertItems（负载组装）之前产出文件。 -->
  <Target Name="PublishAotForMsix" BeforeTargets="_ConvertItems" Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipAotPublish)' != 'true'">
    <Message Importance="high" Text="MSIX: NativeAOT publish -&gt; $(AotPayloadDir)" />
    <Exec Command="dotnet publish &quot;$(AppProject)&quot; -c Release -r win-x64 -p:PublishAot=true -o &quot;$(AotPayloadDir)&quot;" />
  </Target>
  <!-- 把 AOT 产物注入包负载并移除托管负载。四个集合与参考工程的
       RebaseCliPayloadToPackageRoot 同构：WapProjPackageFile / UploadWapProjPackageFile
       驱动 AppxPackagePayload（清单生成 + 打包），_FileToCopy / _UploadFileToCopy
       驱动 PackageLayout 拷贝（ItemSpec=源文件绝对路径，TargetPath=包内相对路径，
       CopyToTargetPath=布局内绝对路径）。
       注入位置是 EhViewerForPc\ 子目录（与清单生成步骤为入口应用展开的
       Executable=EhViewerForPc\EhViewerForPc.exe 一致；入口应用的 Executable
       由管线按 EntryPointProjectUniqueName 重写，字面值会被改写导致
       "清单引用了不属于负载的文件"错误）。 -->
  <Target Name="InjectAotPayload" AfterTargets="_ConvertItems" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_AotSourceFile Include="$(AotPayloadDir)\**\*" Exclude="$(AotPayloadDir)\**\*.pdb" />
      <_EntryManagedPayload Include="@(WapProjPackageFile)" Condition="$([System.String]::Copy('%(WapProjPackageFile.TargetPath)').StartsWith('$(EntryPayloadPrefix)'))" />
    </ItemGroup>
    <ItemGroup Condition="'@(_AotSourceFile)' != ''">
      <WapProjPackageFile Remove="@(_EntryManagedPayload)" />
      <UploadWapProjPackageFile Remove="@(_EntryManagedPayload)" />
      <_FileToCopy Remove="@(_EntryManagedPayload)" />
      <_UploadFileToCopy Remove="@(_EntryManagedPayload)" />
      <WapProjPackageFile Include="%(_AotSourceFile.Identity)">
        <TargetPath>$(EntryPayloadPrefix)%(Filename)%(Extension)</TargetPath>
      </WapProjPackageFile>
      <UploadWapProjPackageFile Include="%(_AotSourceFile.Identity)">
        <TargetPath>$(EntryPayloadPrefix)%(Filename)%(Extension)</TargetPath>
      </UploadWapProjPackageFile>
      <_FileToCopy Include="%(_AotSourceFile.Identity)">
        <TargetPath>$(EntryPayloadPrefix)%(Filename)%(Extension)</TargetPath>
        <CopyToTargetPath>$([System.IO.Path]::Combine($(AotPayloadLayoutRoot), '$(EntryPayloadPrefix)', '%(Filename)%(Extension)'))</CopyToTargetPath>
      </_FileToCopy>
      <_UploadFileToCopy Include="%(_AotSourceFile.Identity)">
        <TargetPath>$(EntryPayloadPrefix)%(Filename)%(Extension)</TargetPath>
        <CopyToTargetPath>$([System.IO.Path]::Combine($(AotPayloadLayoutRoot), '$(EntryPayloadPrefix)', '%(Filename)%(Extension)'))</CopyToTargetPath>
      </_UploadFileToCopy>
    </ItemGroup>
    <Message Condition="'@(_AotSourceFile)' == '' and '$(SkipAotPublish)' == 'true'" Importance="high" Text="MSIX: AOT payload not found at $(AotPayloadDir); packaging managed build output instead. Run without -p:SkipAotPublish=true." />
  </Target>
</Project>