<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MSIX packaging project for the NativeAOT build.

    `dotnet build packaging/EhViewerReader.Msix -c Release` performs three steps:
      1. dotnet publish the app with PublishAot=true into artifacts/win-x64-aot
      2. stage the publish output + manifest + tile assets into artifacts/msix/layout
      3. run MakeAppx from the Windows SDK BuildTools package -> artifacts/msix/*.msix

    MakeAppx/SignTool come from the NuGet package on purpose: this machine's
    Windows SDK ships headers but no tools, and the package also makes the
    build reproducible on machines without the SDK installed.

    Optional properties:
      -p:MsixVersion=1.2.3.4      package version (manifest + file name)
      -p:SkipAotPublish=true      reuse artifacts/win-x64-aot instead of publishing
      -p:MsixPfx=path.pfx         sign the package (with -p:MsixPfxPassword=...)
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <IsPackable>false</IsPackable>
    <AssemblyName>EhViewerReader.Msix</AssemblyName>
    <RootNamespace>EhViewerReader.Msix</RootNamespace>
    <!-- The project has no sources; it only drives publish + MakeAppx. -->
    <NoWarn>$(NoWarn);CS2008</NoWarn>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <AppProject>$(MSBuildThisFileDirectory)..\..\src\EhViewerReader\EhViewerReader.csproj</AppProject>
    <!-- A separate layout directory on purpose: packaging must not fail (or
         overwrite) while the user is running artifacts\win-x64-aot. -->
    <AotPublishDir Condition="'$(AotPublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\msix\aot</AotPublishDir>
    <MsixOutputDir Condition="'$(MsixOutputDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\msix</MsixOutputDir>
    <MsixLayoutDir Condition="'$(MsixLayoutDir)' == ''">$(MsixOutputDir)\layout</MsixLayoutDir>

    <MsixVersion Condition="'$(MsixVersion)' == ''">1.0.0.0</MsixVersion>
    <MsixPackagePath>$(MsixOutputDir)\EhViewerReader_$(MsixVersion)_x64.msix</MsixPackagePath>
    <SkipAotPublish Condition="'$(SkipAotPublish)' == ''">false</SkipAotPublish>

    <!-- Packaging is skipped when this project is built as part of a solution
         (Visual Studio F5/Build, or `dotnet build EhViewerReader.slnx`): a
         multi-minute NativeAOT publish on every solution build is not useful and
         can collide with a running instance. Building this project directly, or
         passing -p:PackMsixOnBuild=true, still produces the package. -->
    <PackMsixOnBuild Condition="'$(PackMsixOnBuild)' == '' and '$(BuildingSolutionFile)' != 'true'">true</PackMsixOnBuild>
    <PackMsixOnBuild Condition="'$(PackMsixOnBuild)' == ''">false</PackMsixOnBuild>

    <!-- Directory inside Microsoft.Windows.SDK.BuildTools; pinned by the
         PackageVersion in Directory.Packages.props. -->
    <WindowsSdkBuildToolsVersion>10.0.26100.0</WindowsSdkBuildToolsVersion>
    <MakeAppxPath>$(PkgMicrosoft_Windows_SDK_BuildTools)\bin\$(WindowsSdkBuildToolsVersion)\x64\makeappx.exe</MakeAppxPath>
    <SignToolPath>$(PkgMicrosoft_Windows_SDK_BuildTools)\bin\$(WindowsSdkBuildToolsVersion)\x64\signtool.exe</SignToolPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <MsixAsset Include="Assets\*.png" />
  </ItemGroup>

  <Target Name="PublishAotApp" Condition="'$(SkipAotPublish)' != 'true'">
    <Message Importance="high" Text="MSIX: publishing NativeAOT app to $(AotPublishDir)" />
    <Exec Command="dotnet publish &quot;$(AppProject)&quot; -c Release -r win-x64 -p:PublishAot=true -o &quot;$(AotPublishDir)&quot; -v m" />
  </Target>

  <Target Name="StageMsixLayout" DependsOnTargets="PublishAotApp">
    <Error Condition="!Exists('$(AotPublishDir)\EhViewerReader.exe')" Text="AOT layout not found: $(AotPublishDir)\EhViewerReader.exe. Run without -p:SkipAotPublish=true." />

    <ItemGroup>
      <_AotFile Include="$(AotPublishDir)\**\*" Exclude="$(AotPublishDir)\**\*.pdb" />
    </ItemGroup>

    <RemoveDir Directories="$(MsixLayoutDir)" />
    <MakeDir Directories="$(MsixLayoutDir);$(MsixLayoutDir)\Assets" />
    <Copy SourceFiles="@(_AotFile)" DestinationFiles="@(_AotFile->'$(MsixLayoutDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <!-- MakeAppx requires the footprint file to be named AppxManifest.xml. -->
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Package.appxmanifest" DestinationFiles="$(MsixLayoutDir)\AppxManifest.xml" />
    <Copy SourceFiles="@(MsixAsset)" DestinationFolder="$(MsixLayoutDir)\Assets" />
    <XmlPoke XmlInputPath="$(MsixLayoutDir)\AppxManifest.xml" Query="/f:Package/f:Identity/@Version" Value="$(MsixVersion)" Namespaces="&lt;Namespace Prefix='f' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;" />
  </Target>

  <Target Name="PackMsix" DependsOnTargets="StageMsixLayout">
    <Error Condition="!Exists('$(MakeAppxPath)')" Text="MakeAppx not found: $(MakeAppxPath)" />
    <MakeDir Directories="$(MsixOutputDir)" />
    <Exec Command="&quot;$(MakeAppxPath)&quot; pack /d &quot;$(MsixLayoutDir)&quot; /p &quot;$(MsixPackagePath)&quot; /o" />
    <Message Importance="high" Text="MSIX package: $(MsixPackagePath)" />
  </Target>

  <Target Name="SignMsix" AfterTargets="PackMsix" Condition="'$(MsixPfx)' != ''">
    <Error Condition="!Exists('$(MsixPfx)')" Text="Certificate not found: $(MsixPfx)" />
    <Exec Condition="'$(MsixPfxPassword)' == ''" Command="&quot;$(SignToolPath)&quot; sign /fd SHA256 /f &quot;$(MsixPfx)&quot; &quot;$(MsixPackagePath)&quot;" />
    <Exec Condition="'$(MsixPfxPassword)' != ''" Command="&quot;$(SignToolPath)&quot; sign /fd SHA256 /f &quot;$(MsixPfx)&quot; /p &quot;$(MsixPfxPassword)&quot; &quot;$(MsixPackagePath)&quot;" />
  </Target>

  <Target Name="BuildMsix" AfterTargets="Build" DependsOnTargets="PackMsix" Condition="'$(PackMsixOnBuild)' == 'true'" />

  <Target Name="MsixSkippedHint" AfterTargets="Build" Condition="'$(PackMsixOnBuild)' != 'true'">
    <Message Importance="high" Text="MSIX: skipped (solution build). Use `dotnet build packaging/EhViewerReader.Msix -c Release` or add -p:PackMsixOnBuild=true." />
  </Target>

</Project>
