<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EhViewerReader.ViewModels"
             xmlns:controls="using:EhViewerReader.Controls"
             xmlns:ir="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ItemsRepeater"
             xmlns:layout="clr-namespace:Avalonia.Layout;assembly=Avalonia.Controls.ItemsRepeater"
             x:Class="EhViewerReader.Views.ImageSearchPage" x:DataType="vm:ImageSearchViewModel"
             DragDrop.AllowDrop="True" KeyDown="OnSearchKeyDown">
  <Grid RowDefinitions="Auto,*,Auto" Background="Transparent">
    <Border Classes="page-header">
      <controls:AdaptiveGrid ColumnDefinitions="*,Auto" Breakpoint="740" ColumnSpacing="12" RowSpacing="8">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Coverage}" FontWeight="SemiBold" />
          <TextBlock Classes="caption" Text="搜索已建立索引的本地页图" />
        </StackPanel>
        <WrapPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="索引设置" Command="{Binding OpenSettingsCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="ImageSearch.Settings" />
          <Button Content="建立 / 更新索引" Command="{Binding BuildIndexCommand}" IsEnabled="{Binding CanBuild}" AutomationProperties.AutomationId="ImageSearch.Build" Margin="0,0,8,6" />
          <Button Content="重新提取重建" Command="{Binding RebuildIndexCommand}" IsEnabled="{Binding CanBuild}" Margin="0,0,8,6" />
          <Button Content="清理旧索引" Command="{Binding CleanupIndexCommand}" IsEnabled="{Binding CanBuild}" Margin="0,0,0,6" />
        </WrapPanel>
      </controls:AdaptiveGrid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <controls:AdaptiveGrid Margin="24,16,24,20" ColumnDefinitions="340,*" Breakpoint="850" ColumnSpacing="20" RowSpacing="20" VerticalAlignment="Top">
        <Border Classes="panel" Padding="16" VerticalAlignment="Top">
          <StackPanel Spacing="12">
            <TextBlock Text="查询图片" FontWeight="SemiBold" />
            <WrapPanel>
              <Button Content="选择图片…" Click="OnOpenFile" Margin="0,0,8,0" AutomationProperties.AutomationId="ImageSearch.OpenFile" />
              <Button Content="粘贴图片" Click="OnPaste" AutomationProperties.AutomationId="ImageSearch.Paste" />
            </WrapPanel>
            <TextBlock Text="{Binding InputName}" Classes="caption" TextTrimming="CharacterEllipsis" />
            <Grid x:Name="PreviewSurface" Height="280" Background="{DynamicResource AppBgBrush}" ClipToBounds="True"
                  IsEnabled="{Binding !IsBusy}"
                  PointerPressed="OnCropPressed" PointerMoved="OnCropMoved" PointerReleased="OnCropReleased">
              <Image x:Name="PreviewImage" Source="{Binding QueryPreview}" Stretch="Uniform" AutomationProperties.AutomationId="ImageSearch.QueryPreview" AutomationProperties.Name="查询图片，拖动选择裁剪区域" />
              <Canvas IsHitTestVisible="False"><Border x:Name="CropRectangle" BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}" BorderThickness="2" IsVisible="False" /></Canvas>
              <TextBlock Text="拖入本地图片，或选择文件" IsVisible="{Binding !HasInput}" Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <CheckBox Content="只搜索裁剪区域" IsChecked="{Binding UseCrop}" IsEnabled="{Binding CanEditCrop}" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8" IsVisible="{Binding UseCrop}" IsEnabled="{Binding CanEditCrop}">
              <StackPanel Spacing="4"><TextBlock Text="X" Classes="caption" /><NumericUpDown Value="{Binding CropX}" Minimum="0" Maximum="16000" FormatString="0" AutomationProperties.Name="裁剪 X" /></StackPanel>
              <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Y" Classes="caption" /><NumericUpDown Value="{Binding CropY}" Minimum="0" Maximum="16000" FormatString="0" AutomationProperties.Name="裁剪 Y" /></StackPanel>
              <StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="宽度" Classes="caption" /><NumericUpDown Value="{Binding CropWidth}" Minimum="1" Maximum="16000" FormatString="0" AutomationProperties.Name="裁剪宽度" /></StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Text="高度" Classes="caption" /><NumericUpDown Value="{Binding CropHeight}" Minimum="1" Maximum="16000" FormatString="0" AutomationProperties.Name="裁剪高度" /></StackPanel>
            </Grid>
            <Button Content="重置裁剪" Command="{Binding ResetCropCommand}" IsVisible="{Binding UseCrop}" IsEnabled="{Binding CanEditCrop}" HorizontalAlignment="Left" />
            <WrapPanel>
              <Button Content="搜索" Classes="accent" Command="{Binding SearchCommand}" IsEnabled="{Binding CanSearch}" Margin="0,0,8,0" AutomationProperties.AutomationId="ImageSearch.Search" />
              <Button Content="取消" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" AutomationProperties.AutomationId="ImageSearch.Cancel" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="1" Spacing="12">
          <TextBlock Text="候选匹配" FontWeight="SemiBold" />
          <TextBlock Text="选择一张截图后搜索，点击结果可从命中页开始阅读。" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !HasResults}" />
          <ir:ItemsRepeater ItemsSource="{Binding Results}" AutomationProperties.AutomationId="ImageSearch.Results">
            <ir:ItemsRepeater.Layout><layout:UniformGridLayout MinItemWidth="180" MinItemHeight="352" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" /></ir:ItemsRepeater.Layout>
            <ir:ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:ImageSearchResultItem">
                <Border Classes="panel" Padding="10">
                  <StackPanel Spacing="6">
                    <controls:AsyncImage Source="{Binding Thumbnail}" Height="190" Stretch="Uniform" />
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2" MinHeight="36" />
                    <TextBlock Text="{Binding Subtitle}" Classes="caption" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Score}" Classes="caption" />
                    <Button Content="从此页阅读" Click="OnReadHit" AutomationProperties.AutomationId="ImageSearch.ReadHit" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ir:ItemsRepeater.ItemTemplate>
          </ir:ItemsRepeater>
        </StackPanel>
      </controls:AdaptiveGrid>
    </ScrollViewer>
    <Border Grid.Row="2" Classes="statusbar">
      <StackPanel Spacing="6">
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Classes="caption" AutomationProperties.AutomationId="ImageSearch.Status" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
