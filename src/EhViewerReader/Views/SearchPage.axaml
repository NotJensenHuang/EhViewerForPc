<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EhViewerReader.ViewModels"
             xmlns:ir="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ItemsRepeater"
             xmlns:layout="clr-namespace:Avalonia.Layout;assembly=Avalonia.Controls.ItemsRepeater"
             x:Class="EhViewerReader.Views.SearchPage"
             x:DataType="vm:SearchPageViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" Background="{DynamicResource AppBgBrush}">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="22,16,22,8">
      <StackPanel Spacing="2">
        <TextBlock Text="搜索" Classes="h1" />
        <TextBlock Classes="caption" Text="关键词 + 标签语法（如 language:chinese female:sole female），可组合分类与页数范围" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="高级选项" Classes="chip" Command="{Binding ToggleAdvancedCommand}" />
        <Button Content="保存当前搜索" Command="{Binding SaveSearchCommand}" />
        <Button Content="重置" Command="{Binding ResetCommand}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,10,Auto" Margin="22,0,22,8">
      <TextBox x:Name="QueryBox" Text="{Binding Query}" PlaceholderText="关键词或标签" KeyDown="OnQueryKeyDown" />
      <Button Grid.Column="2" Classes="primary" Content="搜索" Command="{Binding SearchCommand}" MinWidth="88" />
    </Grid>

    <Border Grid.Row="2" Classes="tile" Margin="22,0,22,10" Padding="16,14" IsVisible="{Binding ShowAdvanced}">
      <StackPanel Spacing="12">
        <StackPanel Spacing="6">
          <TextBlock Text="分类" Classes="h2" />
          <ItemsControl ItemsSource="{Binding Categories}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CategoryToggle">
                <ToggleButton Classes="chip" Content="{Binding Label}" IsChecked="{Binding IsEnabled}"
                              Foreground="{Binding Brush}" Margin="0,0,8,8" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="页数" Classes="secondary" VerticalAlignment="Center" />
            <TextBox Width="70" Text="{Binding MinPages}" PlaceholderText="最少" />
            <TextBlock Text="—" Classes="muted" VerticalAlignment="Center" />
            <TextBox Width="70" Text="{Binding MaxPages}" PlaceholderText="最多" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="语言" Classes="secondary" VerticalAlignment="Center" />
            <ComboBox Width="120" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FeedOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </StackPanel>

        <WrapPanel Orientation="Horizontal">
          <CheckBox Content="搜索标题" IsChecked="{Binding SearchName}" Margin="0,0,18,0" />
          <CheckBox Content="搜索标签" IsChecked="{Binding SearchTags}" Margin="0,0,18,0" />
          <CheckBox Content="搜索描述" IsChecked="{Binding SearchDescription}" Margin="0,0,18,0" />
          <CheckBox Content="仅含种子" IsChecked="{Binding OnlyTorrents}" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="3" Margin="22,0,22,8" Spacing="6" IsVisible="{Binding HasHistory}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="最近搜索" Classes="caption" VerticalAlignment="Center" />
        <Button Content="清空/隐藏" Classes="ghost" FontSize="11" Padding="6,2" MinHeight="22"
                Command="{Binding ToggleHistoryCommand}" />
      </StackPanel>
      <ItemsControl ItemsSource="{Binding History}" IsVisible="{Binding ShowHistory}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TextItem">
            <Button Classes="chip" Content="{Binding Text}" Tag="{Binding Text}" Margin="0,0,8,8" Click="OnHistoryClick" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel Grid.Row="4" Margin="22,0,22,10" Spacing="6" IsVisible="{Binding HasSavedSearches}">
      <TextBlock Text="已保存的搜索" Classes="caption" />
      <ItemsControl ItemsSource="{Binding SavedSearches}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TextItem">
            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="999" Padding="10,3" Margin="0,0,8,8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="{Binding Text}" Classes="ghost" FontSize="11" Padding="0" MinHeight="0"
                        Tag="{Binding Text}" Click="OnSavedClick" />
                <Button Content="✕" Classes="ghost" FontSize="10" Padding="0" MinHeight="0"
                        Tag="{Binding Text}" Click="OnSavedRemoveClick" ToolTip.Tip="删除该保存的搜索" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <Grid Grid.Row="5">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Padding="22,0,22,20">
          <ir:ItemsRepeater ItemsSource="{Binding Items}" ItemTemplate="{StaticResource OnlineGalleryCard}">
            <ir:ItemsRepeater.Layout>
              <layout:UniformGridLayout MinItemWidth="196" MinItemHeight="352"
                                        MinColumnSpacing="14" MinRowSpacing="14"
                                        ItemsStretch="Fill" />
            </ir:ItemsRepeater.Layout>
          </ir:ItemsRepeater>
        </Border>
      </ScrollViewer>

      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                  IsVisible="{Binding ShowEmpty}">
        <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Classes="secondary" Text="试试标签语法：female:sole female、language:chinese、gid:123456" />
      </StackPanel>

      <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top" IsVisible="{Binding IsBusy}" />
    </Grid>

    <Border Grid.Row="6" Padding="22,9" MinHeight="36" BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusText}" Classes="secondary" FontSize="11" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding PageLabel}" Classes="caption" VerticalAlignment="Center" />
          <Button Content="上一页" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoBack}" />
          <Button Content="下一页" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasMore}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
