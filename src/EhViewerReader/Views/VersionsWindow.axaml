<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:EhViewerReader.ViewModels"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
        x:Class="EhViewerReader.Views.VersionsWindow"
        x:DataType="vm:VersionsViewModel"
        Title="版本管理" Width="900" Height="560" MinWidth="760" MinHeight="420"
        Background="{DynamicResource AppBgBrush}"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppBgBrush}">
    <Border Grid.Row="0" Padding="22,18,22,14" BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,0,0,1">
      <StackPanel Spacing="5">
        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{Binding GidText}" Classes="caption" FontFamily="{DynamicResource AppMonoFont}" />
          <TextBlock Text="{Binding SummaryText}" Classes="caption" />
        </StackPanel>
        <TextBlock Text="{Binding DefaultHint}" Classes="secondary" FontSize="11" TextWrapping="Wrap" />
        <TextBlock Text="{Binding DifferHint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <Border Padding="22,14">
      <ItemsControl ItemsSource="{Binding Versions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="10" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GalleryVersionViewModel">
            <Border Classes="panel" Padding="14,12">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                  <Border Background="{DynamicResource AppAccentSoftBrush}" CornerRadius="999" Padding="9,2"
                          IsVisible="{Binding IsPrimary}">
                    <TextBlock Text="默认" FontSize="10" Foreground="{DynamicResource AppAccentBrush}" />
                  </Border>
                  <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold" FontSize="12"
                             VerticalAlignment="Center" MaxWidth="320" TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourceName}" />
                  <TextBlock Text="{Binding PageCountText}" Classes="caption" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding StatusText}" Classes="caption" VerticalAlignment="Center"
                             Foreground="{DynamicResource AppWarningBrush}"
                             IsVisible="{Binding IsIncomplete}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Button Content="用此版本阅读" Classes="primary" FontSize="11" Padding="10,3" MinHeight="26"
                          Tag="{Binding}" Click="OnRead" ToolTip.Tip="设为默认副本并打开阅读器" />
                  <Button Content="设为默认" FontSize="11" Padding="10,3" MinHeight="26"
                          Tag="{Binding}" Click="OnSetDefault" IsEnabled="{Binding !IsPrimary}" />
                  <Button Content="打开文件夹" Classes="ghost" FontSize="11" Padding="10,3" MinHeight="26"
                          Tag="{Binding}" Click="OnOpenFolder" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding FolderName}"
                           Classes="secondary" FontSize="11" Margin="0,7,0,0"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding FolderPath}" />

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                            Spacing="12" Margin="0,3,0,0">
                  <TextBlock Text="{Binding DetailText}" Classes="muted" FontSize="10" />
                  <TextBlock Text="{Binding LastWriteText}" Classes="muted" FontSize="10" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </Border>
    </ScrollViewer>

    <Border Grid.Row="2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="20,13">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="同一作品的多份副本只显示为一张卡片；阅读进度与收藏按作品共享，切换版本不会丢失。" />
        <Button Grid.Column="1" Content="关闭" Click="OnClose" />
      </Grid>
    </Border>
  </Grid>
</Window>
