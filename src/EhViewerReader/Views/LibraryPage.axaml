<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EhViewerReader.ViewModels"
             xmlns:controls="using:EhViewerReader.Controls"
             xmlns:ir="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ItemsRepeater"
             xmlns:layout="clr-namespace:Avalonia.Layout;assembly=Avalonia.Controls.ItemsRepeater"
             x:Class="EhViewerReader.Views.LibraryPage"
             x:DataType="vm:MainViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource AppBgBrush}">
    <!-- Toolbar -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,16,*,10,Auto,8,Auto" Margin="22,16,22,10">
      <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="本地库" Classes="h1" />
        <TextBlock Classes="caption" Text="{Binding RootDisplay}" MaxWidth="360" TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <Grid Grid.Column="2" VerticalAlignment="Center">
        <TextBox x:Name="SearchBox" Text="{Binding SearchText}" PlaceholderText="搜索标题、文件夹或 GID（Ctrl+F）" />
        <Button Content="清除" Classes="ghost" HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,0,4,0" FontSize="11" Click="OnClearSearch"
                IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </Grid>

      <ComboBox Grid.Column="4" Width="120" ItemsSource="{Binding SortOptions}"
                SelectedItem="{Binding SelectedSort}" VerticalAlignment="Center">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SortOption">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <Button Grid.Column="6" Content="刷新" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
    </Grid>

    <!-- Filters -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="22,0,22,8">
      <ItemsControl Grid.Column="0" ItemsSource="{Binding FilterOptions}" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FilterOption">
            <Button Classes="chip" Classes.active="{Binding IsActive}" Content="{Binding Label}"
                    Tag="{Binding}" Click="OnFilterClick" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ComboBox Grid.Column="1" Width="126" ItemsSource="{Binding LanguageOptions}"
                SelectedItem="{Binding SelectedLanguage}" VerticalAlignment="Center">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LanguageOption">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <!-- Grid -->
    <Grid Grid.Row="2">
      <ScrollViewer x:Name="LibraryScroll" VerticalScrollBarVisibility="Auto"
                    ScrollChanged="OnLibraryScrollChanged">
        <Border Padding="22,6,22,20">
          <ir:ItemsRepeater x:Name="LibraryRepeater" ItemsSource="{Binding Galleries}">
            <ir:ItemsRepeater.Layout>
              <layout:UniformGridLayout MinItemWidth="196" MinItemHeight="352"
                                        MinColumnSpacing="14" MinRowSpacing="14"
                                        ItemsStretch="Fill" />
            </ir:ItemsRepeater.Layout>
            <ir:ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:GalleryItemViewModel">
                <Border Classes="card" Height="352" ToolTip.Tip="{Binding TooltipText}"
                        Focusable="True" Tapped="OnCardTapped" ContextRequested="OnCardContextRequested"
                        KeyDown="OnCardKeyDown">
                  <Grid RowDefinitions="266,Auto,*">
                    <Border CornerRadius="8" ClipToBounds="True" Background="{DynamicResource AppBgAltBrush}">
                      <Grid>
                        <controls:AsyncImage Source="{Binding CoverRequest}" Stretch="UniformToFill" />

                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="8"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                          <Border Background="#B3000000" CornerRadius="6" Padding="7,2">
                            <TextBlock Text="{Binding PageCountText}" FontSize="10" Foreground="#F2F4F8" />
                          </Border>
                          <Border Background="#CC3A1D24" CornerRadius="6" Padding="7,2"
                                  IsVisible="{Binding HasMultipleVersions}" Tapped="OnVersionsClick"
                                  ToolTip.Tip="{Binding VersionSummary}">
                            <TextBlock Text="{Binding VersionBadge}" FontSize="10" Foreground="#FFB3BF" />
                          </Border>
                        </StackPanel>

                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                Background="#CC3A1D24" CornerRadius="6" Padding="7,2"
                                IsVisible="{Binding IsIncomplete}">
                          <TextBlock Text="{Binding IncompleteText}" FontSize="10" Foreground="#FFB3BF" />
                        </Border>

                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,26"
                                Background="#B3000000" CornerRadius="6" Padding="7,2"
                                IsVisible="{Binding IsFavorite}">
                          <TextBlock Text="♥ 收藏" FontSize="10" Foreground="#FF6B81" />
                        </Border>

                        <ProgressBar VerticalAlignment="Bottom" Height="3" Minimum="0" Maximum="1"
                                     Value="{Binding ProgressFraction}" />
                      </Grid>
                    </Border>

                    <TextBlock Grid.Row="1" Classes="title" Text="{Binding Title}" TextWrapping="Wrap"
                               MaxLines="2" Height="40" Margin="0,9,0,0" />
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="caption" Text="{Binding GidText, StringFormat='#{0}'}" />
                        <TextBlock Classes="caption" Text="{Binding LanguageText}" IsVisible="{Binding HasLanguages}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Classes="caption" Text="{Binding ProgressText}" />
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ir:ItemsRepeater.ItemTemplate>
          </ir:ItemsRepeater>
        </Border>
      </ScrollViewer>

      <!-- Welcome -->
      <Border Classes="panel" Width="580" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center"
              IsVisible="{Binding ShowWelcome}">
        <StackPanel Spacing="12">
          <TextBlock Text="选择 EhViewer 下载目录" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Classes="secondary" TextWrapping="Wrap"
                     Text="支持 EhViewer / Ehviewer_CN_SXJ 的下载目录结构：gid-标题 文件夹、.ehviewer 元数据、.thumb 封面与 8 位数字页文件。也可以直接使用本应用「下载」页产出的目录。目录只会被读取，不会修改。" />
          <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                     Text="设置、阅读进度与缓存写入 %LocalAppData%\EhViewerReader。" />
          <TextBlock Classes="caption" FontSize="11" TextWrapping="Wrap" Text="{Binding StatusText}" />
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
            <Button Classes="primary" Content="选择资料库" Click="OnChooseFolder" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Initial scan -->
      <Border Classes="panel" Width="380" Padding="24,18" HorizontalAlignment="Center" VerticalAlignment="Center"
              IsVisible="{Binding ShowInitialScan}">
        <StackPanel Spacing="10">
          <TextBlock Text="正在扫描资料库…" FontWeight="SemiBold" />
          <ProgressBar IsIndeterminate="True" Height="4" />
          <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
          <TextBlock Classes="muted" FontSize="11"
                     Text="首次扫描需要遍历全部页文件；可取消，已扫描部分不会写入资料库。" />
        </StackPanel>
      </Border>

      <!-- No results -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                  IsVisible="{Binding ShowNoResults}">
        <TextBlock Text="没有可显示的画廊" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Classes="secondary" Text="资料库为空，或调整搜索词/筛选条件" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="3" x:Name="StatusBar" Padding="22,9" MinHeight="36"
            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" ClipToBounds="True">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" ClipToBounds="True">
          <TextBlock Text="{Binding StatusText}" Classes="secondary" FontSize="11"
                     TextTrimming="CharacterEllipsis" MaxWidth="440" />
          <ProgressBar Width="110" Height="4" Minimum="0" Maximum="100" Value="{Binding ScanPercent}"
                       IsVisible="{Binding IsScanning}" VerticalAlignment="Center" />
          <Button Content="取消扫描" Classes="ghost" FontSize="11" Padding="8,2" MinHeight="24"
                  Command="{Binding CancelScanCommand}" IsVisible="{Binding IsScanning}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ScanPhase}" Classes="muted" FontSize="11" IsVisible="{Binding IsScanning}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Classes="muted" FontSize="11" Text="{Binding FilteredCount, StringFormat='显示 {0:N0}'}" />
          <TextBlock Classes="muted" FontSize="11" Text="{Binding TotalGalleryCount, StringFormat='共 {0:N0} 个作品'}" />
          <Button Content="设置" Classes="ghost" FontSize="11" Padding="8,2" MinHeight="24" Click="OnOpenSettings" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
