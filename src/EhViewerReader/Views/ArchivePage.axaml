<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:EhViewerReader.ViewModels"
        xmlns:controls="using:EhViewerReader.Controls"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="560"
        x:Class="EhViewerReader.Views.ArchivePage"
        x:DataType="vm:ArchiveViewModel"
        Background="Transparent">
  <Grid Background="Transparent" RowDefinitions="Auto,*,Auto">
    <!-- The page identity comes from the shell header ("归档下载"); this row
         carries the work title and the page actions only. -->
    <Border Grid.Row="0" Classes="page-header">
      <controls:AdaptiveGrid Breakpoint="620" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="8">
        <StackPanel Spacing="3">
          <SelectableTextBlock Text="{Binding GalleryTitle}" FontWeight="SemiBold" MaxLines="1"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding GalleryTitle}" />
          <SelectableTextBlock Text="{Binding Subtitle}" Classes="caption" TextWrapping="Wrap" />
        </StackPanel>
        <WrapPanel Grid.Column="1" Orientation="Horizontal" Classes="actions" VerticalAlignment="Center">
          <Button Content="刷新" Command="{Binding RefreshCommand}" />
          <Button Content="关闭" Click="OnClose" />
        </WrapPanel>
      </controls:AdaptiveGrid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,14,24,18" Spacing="12">
        <Border Classes="tile">
          <StackPanel Spacing="10">
            <SelectableTextBlock Text="归档格式" Classes="h2" />
            <SelectableTextBlock Classes="caption" TextWrapping="Wrap"
                       Text="选择原图或压缩图归档。" />

            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="归档格式"
                      IsVisible="{Binding HasOptions}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FeedOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <WrapPanel Orientation="Horizontal" Classes="actions">
              <Button Classes="accent" Content="请求归档" Command="{Binding RequestCommand}"
                      IsEnabled="{Binding CanRequest}" />
              <Button Content="下载链接 / 打开页面" Command="{Binding OpenInBrowserCommand}" />
              <Button Content="打开下载目录" Classes="ghost" Command="{Binding OpenDownloadFolderCommand}" />
              <Button Content="H@H 设置" Classes="ghost" Command="{Binding OpenHathPageCommand}"
                      IsVisible="{Binding NeedsHath}" />
            </WrapPanel>

            <StackPanel Spacing="4" IsVisible="{Binding ShowProgress}">
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="6" />
              <SelectableTextBlock Classes="caption" Text="{Binding ProgressText}" />
            </StackPanel>

            <controls:AdaptiveGrid Breakpoint="560" ColumnDefinitions="Auto,*" ColumnSpacing="10" RowSpacing="8"
                                   IsVisible="{Binding HasDownloadUrl}">
              <Button Content="再次下载归档" Command="{Binding SaveAgainCommand}" />
              <SelectableTextBlock Grid.Column="1" Classes="caption" Text="{Binding DownloadUrl}"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         ToolTip.Tip="{Binding DownloadUrl}" />
            </controls:AdaptiveGrid>
          </StackPanel>
        </Border>

        <Border Classes="tile" IsVisible="{Binding NeedsHath}">
          <StackPanel Spacing="6">
            <SelectableTextBlock Text="需要 H@H 客户端" Classes="h2" />
            <SelectableTextBlock Classes="secondary" TextWrapping="Wrap"
                       Text="请先在站点分配 H@H 客户端，或使用逐页下载。" />
          </StackPanel>
        </Border>

        <Border Classes="tile" IsVisible="{Binding HasDetail}">
          <StackPanel Spacing="4">
            <SelectableTextBlock Text="站点返回" Classes="h2" />
            <SelectableTextBlock Text="{Binding DetailText}" Classes="secondary" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="tile" IsVisible="{Binding NeedsSignIn}">
          <StackPanel Spacing="4">
            <SelectableTextBlock Text="需要登录" Classes="h2" />
            <SelectableTextBlock Classes="secondary" TextWrapping="Wrap"
                       Text="请先登录账号。" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Classes="statusbar">
      <SelectableTextBlock Text="{Binding StatusText}" Classes="secondary" FontSize="12" VerticalAlignment="Center"
                 TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
