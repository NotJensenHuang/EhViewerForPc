<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EhViewerReader.ViewModels"
             xmlns:controls="using:EhViewerReader.Controls"
             x:Class="EhViewerReader.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Background="Transparent">
    <WrapPanel Grid.Row="0" Margin="22,12,22,10">
      <Button Content="打开数据目录" Click="OnOpenDataDirectory" />
      <Button Content="清除扫描缓存" Click="OnClearCache" />
      <Button IsEnabled="{Binding !IsSaving}" Classes="accent" Content="{Binding SaveLabel}" Click="OnApplyAll" />
    </WrapPanel>

    <TabControl IsEnabled="{Binding !IsSaving}" x:Name="SettingsTabs" Grid.Row="1" Margin="16,0,16,12">
      <TabItem><TabItem.Header><TextBlock Text="账号" FontSize="14" /></TabItem.Header><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,0,12">
<Border Classes="tile">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <SelectableTextBlock Text="账号" Classes="h2" />
              <SelectableTextBlock Grid.Column="1" Classes="caption" Text="{Binding AccountUserText}" />
            </Grid>

            <Border IsVisible="{Binding !IsSignedIn}" Background="{DynamicResource AppBgAltBrush}" CornerRadius="10" Padding="14,12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel Spacing="4">
                  <SelectableTextBlock Text="网页登录" FontWeight="Bold" />
                  <SelectableTextBlock Classes="caption" TextWrapping="Wrap"
                             Text="在浏览器中完成登录后返回。" />
                </StackPanel>
                <Button Grid.Column="1" Classes="accent" Content="网页登录" Click="OnWebLogin"
                        VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Grid IsVisible="{Binding IsSignedIn}" ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4"><SelectableTextBlock Text="账号已登录" FontWeight="Bold" /></StackPanel>
              <Button Grid.Column="1" Content="更换账号" Click="OnWebLogin" VerticalAlignment="Center" />
            </Grid>
            <WrapPanel Orientation="Horizontal">
              <SelectableTextBlock Margin="0,0,12,8" Text="站点" Classes="secondary" VerticalAlignment="Center" />
              <ComboBox Margin="0,0,12,8" Width="132" ItemsSource="{Binding SiteLabels}" SelectedIndex="{Binding SiteIndex}" />
              <SelectableTextBlock Margin="0,0,12,8" Classes="caption" VerticalAlignment="Center"
                         Text="{Binding ExAccessText, StringFormat='ExHentai：{0}'}" />
              <SelectableTextBlock Margin="0,0,12,8" Classes="caption" VerticalAlignment="Center"
                         Text="{Binding LastSignInText, StringFormat='最近登录：{0}'}" />
            </WrapPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button IsVisible="{Binding IsSignedIn}" Content="退出登录" Command="{Binding SignOutCommand}" />
              <Button IsEnabled="{Binding IsSignedIn}" Content="检测 ExHentai" Command="{Binding CheckExAccessCommand}" />
              <Button Content="注册账号" Classes="ghost" Command="{Binding OpenRegisterPageCommand}" />
            </StackPanel>

            <Expander IsVisible="{Binding !IsSignedIn}" Header="密码登录">
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <Grid ColumnDefinitions="*,10,*" ColumnSpacing="0">
                  <TextBox Grid.Column="0" Text="{Binding UserNameInput}" PlaceholderText="用户名" />
                  <TextBox Grid.Column="2" Text="{Binding PasswordInput}" PasswordChar="●" PlaceholderText="密码（不会保存）" />
                </Grid>
                <Button Content="直接登录" Command="{Binding LoginCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </Expander>

            <Expander IsVisible="{Binding !IsSignedIn}" Header="导入 Cookie">
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <SelectableTextBlock Classes="caption" TextWrapping="Wrap"
                           Text="粘贴 Cookie、cURL 或 JSON。" />
                <Grid ColumnDefinitions="*,10,Auto" ColumnSpacing="0">
                  <TextBox Grid.Column="0" Text="{Binding CookieInput}" AcceptsReturn="True" Height="72"
                           TextWrapping="Wrap" PlaceholderText="ipb_member_id=…; ipb_pass_hash=…; igneous=…" />
                  <Button Grid.Column="2" Content="验证并导入" Command="{Binding ImportCookiesCommand}"
                          VerticalAlignment="Bottom" />
                </Grid>
              </StackPanel>
            </Expander>

            <SelectableTextBlock Text="{Binding AccountStatus}" Classes="caption"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem><TabItem.Header><TextBlock Text="网络" FontSize="14" /></TabItem.Header><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,0,12">
<Border Classes="tile">
          <StackPanel Spacing="12">
            <SelectableTextBlock Text="网络与代理" Classes="h2" />

            <WrapPanel Orientation="Horizontal">
              <SelectableTextBlock Margin="0,0,12,8" Text="代理模式" Classes="secondary" VerticalAlignment="Center" />
              <ComboBox Margin="0,0,12,8" ItemsSource="{Binding ProxyModeLabels}" SelectedIndex="{Binding ProxyModeIndex}" />
              <CheckBox Content="图片也走代理" IsChecked="{Binding ProxyForImages}" VerticalAlignment="Center" />
            </WrapPanel>

            <controls:AdaptiveGrid RowSpacing="8" ColumnDefinitions="*,10,110,10,*,10,*" ColumnSpacing="0" IsVisible="{Binding IsManualProxy}">
              <TextBox Grid.Column="0" Text="{Binding ProxyHost}" PlaceholderText="代理主机" />
              <TextBox Grid.Column="2" Text="{Binding ProxyPort}" PlaceholderText="端口" />
              <TextBox Grid.Column="4" Text="{Binding ProxyUserName}" PlaceholderText="用户名（可选）" />
              <TextBox Grid.Column="6" Text="{Binding ProxyPassword}" PasswordChar="●" PlaceholderText="密码（可选）" />
            </controls:AdaptiveGrid>

            <CheckBox Content="使用 DNS over HTTPS 解析域名" IsChecked="{Binding UseDoh}" />
            <controls:AdaptiveGrid RowSpacing="8" ColumnDefinitions="*,10,*" ColumnSpacing="0" IsVisible="{Binding UseDoh}">
              <TextBox Grid.Column="0" Text="{Binding DohEndpoint}" PlaceholderText="DoH 端点" />
              <TextBox Grid.Column="2" Text="{Binding HostsOverride}" PlaceholderText="自定义 hosts（每行：host ip）" />
            </controls:AdaptiveGrid>

            <StackPanel Orientation="Horizontal" Spacing="8">

              <Button Content="测试连接" Command="{Binding TestNetworkCommand}" />
              <SelectableTextBlock Text="{Binding NetworkStatus}" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            </StackPanel>
        </Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem><TabItem.Header><TextBlock Text="浏览" FontSize="14" /></TabItem.Header><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,0,12">
<Border Classes="tile">
          <StackPanel Spacing="12">
            <SelectableTextBlock Text="在线浏览" Classes="h2" />

            <WrapPanel Orientation="Horizontal">
              <CheckBox Content="显示中文标签翻译" IsChecked="{Binding ShowTagTranslations}" Margin="0,0,18,0" />
              <WrapPanel Orientation="Horizontal">
                <SelectableTextBlock Text="图片尺寸" Classes="secondary" VerticalAlignment="Center" />
                <ComboBox Width="238" ItemsSource="{Binding ImageQualityOptions}"
                          SelectedIndex="{Binding ImageQualityIndex}" VerticalAlignment="Center">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FeedOption">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox AutomationProperties.Name="压缩图片宽度" Width="136" ItemsSource="{Binding ResampledWidths}" SelectedIndex="{Binding ResampledWidthIndex}" />
                <Button Content="站点图片设置" Classes="ghost" Command="{Binding OpenSiteImageSettingsCommand}"
                        VerticalAlignment="Center" ToolTip.Tip="在站点 uconfig.php 中调整压缩图宽度（780/980/1280/1600/2400）" />
</WrapPanel>
            </WrapPanel>
            <SelectableTextBlock Classes="caption" Text="{Binding ImageQualityHint}" TextWrapping="Wrap" />

            <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,4" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <StackPanel Spacing="2">
                <SelectableTextBlock Text="在线图片缓存" Classes="secondary" />
                <SelectableTextBlock Classes="caption" Text="{Binding CacheUsageText}" />
              </StackPanel>
              <Button Grid.Column="1" Content="清除在线缓存" Click="OnClearOnlineCache" VerticalAlignment="Center" />
            </Grid>
            <Grid ColumnDefinitions="90,*,54" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="8">
              <SelectableTextBlock Text="磁盘上限" Classes="secondary" VerticalAlignment="Center" />
              <Slider Grid.Column="1" AutomationProperties.Name="在线缓存上限" Minimum="128" Maximum="32768"
                      TickFrequency="128" Value="{Binding OnlineCacheMegabytes}" />
              <SelectableTextBlock Grid.Column="2" Text="{Binding OnlineCacheLabel}" VerticalAlignment="Center" />
              <SelectableTextBlock Grid.Row="1" Text="保留时间" Classes="secondary" VerticalAlignment="Center" />
              <Slider Grid.Row="1" Grid.Column="1" AutomationProperties.Name="在线缓存保留时间" Minimum="0" Maximum="90"
                      TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding OnlineCacheDays}"
                      ToolTip.Tip="0 表示不限制保留时间，只按磁盘上限淘汰" />
              <SelectableTextBlock Grid.Row="1" Grid.Column="2" Text="{Binding OnlineCacheDaysLabel}" VerticalAlignment="Center" />
            </Grid>
            <SelectableTextBlock Classes="caption" Text="缩略图与在线阅读页图共用此上限，默认 512 MB；按最近使用时间淘汰，保留时间为 0 时不限时间、仅在超出上限时淘汰。正式下载文件、阅读进度与历史记录不受影响。" TextWrapping="Wrap" />

            <Grid ColumnDefinitions="*,10,Auto" ColumnSpacing="0">
              <TextBox Grid.Column="0" Text="{Binding TagTranslationUrl}" PlaceholderText="标签翻译库地址" />
              <Button Grid.Column="2" Content="更新标签库" Command="{Binding UpdateTagTranslationsCommand}"
                      IsEnabled="{Binding !UpdatingTags}" />
            </Grid>
            <SelectableTextBlock Text="{Binding TagTranslationStatus}" Classes="caption" TextWrapping="Wrap" />
            <SelectableTextBlock Classes="caption" TextWrapping="Wrap"
                       Text="EhTagTranslation 标签库" />

            <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,4" />

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <SelectableTextBlock Text="列表过滤" Classes="secondary" />
                </StackPanel>
              <Button Grid.Column="1" Content="添加规则" Command="{Binding AddFilterCommand}"
                      VerticalAlignment="Center" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Filters}" IsVisible="{Binding HasFilters}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterRuleViewModel">
                  <Grid ColumnDefinitions="Auto,*,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8" Margin="0,0,0,12">
                    <CheckBox IsChecked="{Binding Enabled}" AutomationProperties.Name="启用过滤规则" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding TargetLabels}" SelectedIndex="{Binding TargetIndex}" AutomationProperties.Name="过滤目标" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding IncludeLabels}" SelectedIndex="{Binding IncludeIndex}" AutomationProperties.Name="过滤方式" />
                    <Button Grid.Column="3" Content="移除" Classes="ghost" Tag="{Binding}" Click="OnRemoveFilter" />
                    <TextBox Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding Text}" PlaceholderText="要匹配的文字" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <SelectableTextBlock Text="{Binding FilterStatus}" Classes="caption" />

            <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,4" />

            <Grid ColumnDefinitions="Auto,12,*" ColumnSpacing="0">
              <SelectableTextBlock Text="收藏分类命名" Classes="secondary" VerticalAlignment="Center" />
              <SelectableTextBlock Grid.Column="2" Classes="caption" Text="{Binding FavoriteSlotStatus}"
                         VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
            <ItemsControl ItemsSource="{Binding FavoriteSlots}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FavoriteSlotRowViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,8" Width="230">
                    <SelectableTextBlock Text="{Binding SlotLabel}" Classes="caption" Width="52" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Name}" Width="166" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem><TabItem.Header><TextBlock Text="下载" FontSize="14" /></TabItem.Header><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,0,12">
<Border Classes="tile">
          <StackPanel Spacing="12">
            <SelectableTextBlock Text="下载目录与本地库" Classes="h2" />

            <Grid ColumnDefinitions="*,10,Auto,8,Auto" ColumnSpacing="0">
              <TextBox Grid.Column="0" Text="{Binding DownloadRoot}" PlaceholderText="下载根目录" />
              <Button Grid.Column="2" Content="浏览…" Click="OnPickDownloadRoot" />
              <Button Grid.Column="4" Content="打开目录" Command="{Binding OpenDownloadFolderCommand}" />
            </Grid>

            <StackPanel Spacing="6">
              <SelectableTextBlock Text="变更目录时" Classes="secondary" />
              <ComboBox AutomationProperties.Name="下载目录变更方式" ItemsSource="{Binding DownloadDirectoryModes}" SelectedIndex="{Binding DownloadDirectoryMode}" HorizontalAlignment="Stretch" />
              <SelectableTextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding DownloadDirectoryHint}" />
            </StackPanel>
            <WrapPanel Orientation="Horizontal">
              <CheckBox Content="注册为本地库数据源" IsChecked="{Binding DownloadAddAsSource}" Margin="0,0,18,0" />
              <CheckBox Content="写入 .thumb 封面" IsChecked="{Binding WriteThumb}" Margin="0,0,18,0" />
              <CheckBox Content="写入 .ehviewer 元数据" IsChecked="{Binding WriteHeader}" />
            </WrapPanel>
            <SelectableTextBlock Classes="caption" TextWrapping="Wrap"
                       Text="图片尺寸与在线阅读设置相同。" />

            <WrapPanel Orientation="Horizontal">
              <CheckBox Content="启动时自动继续" IsChecked="{Binding AutoStart}" Margin="0,0,18,0" />
              <CheckBox Content="自动更新本地库" IsChecked="{Binding RefreshAfterDownload}" Margin="0,0,18,0" />
            </WrapPanel>

            <Grid ColumnDefinitions="90,*,32" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
              <SelectableTextBlock Text="并发画廊" Classes="secondary" VerticalAlignment="Center" />
              <Slider Grid.Column="1" AutomationProperties.Name="并发画廊" Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MaxConcurrentTasks}" />
              <SelectableTextBlock Grid.Column="2" Text="{Binding MaxConcurrentTasks}" VerticalAlignment="Center" />
              <SelectableTextBlock Grid.Row="1" Text="并发页面" Classes="secondary" VerticalAlignment="Center" />
              <Slider Grid.Row="1" Grid.Column="1" AutomationProperties.Name="并发页面" Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MaxConcurrentPages}" />
              <SelectableTextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MaxConcurrentPages}" VerticalAlignment="Center" />
            </Grid>

            <Grid ColumnDefinitions="Auto,10,*" ColumnSpacing="0">
              <SelectableTextBlock Text="默认标签" Classes="secondary" VerticalAlignment="Center" />
              <TextBox Grid.Column="2" Text="{Binding DefaultDownloadLabel}" PlaceholderText="可选：下载到该子目录" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">

              </StackPanel>

            <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,4" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <StackPanel Spacing="2">
                <SelectableTextBlock Text="H@H / 归档下载" Classes="secondary" />
                <SelectableTextBlock Text="{Binding HathStatus}" Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Content="打开 H@H 页面" Command="{Binding OpenHathPageCommand}"
                      VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem><TabItem.Header><TextBlock Text="阅读" FontSize="14" /></TabItem.Header><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,0,12">
<Border Classes="tile">
          <StackPanel Spacing="12">
            <SelectableTextBlock Text="阅读器" Classes="h2" />
            <WrapPanel Orientation="Horizontal">
              <StackPanel Width="150" Spacing="4" Margin="0,0,12,12"><SelectableTextBlock Text="主题" /><ComboBox ItemsSource="{Binding ThemeLabels}" SelectedIndex="{Binding ThemeIndex}" /></StackPanel>
              <StackPanel Width="150" Spacing="4" Margin="0,0,12,12"><SelectableTextBlock Text="默认模式" /><ComboBox ItemsSource="{Binding ModeLabels}" SelectedIndex="{Binding ModeIndex}" /></StackPanel>
              <StackPanel Width="150" Spacing="4" Margin="0,0,12,12"><SelectableTextBlock Text="背景" /><ComboBox ItemsSource="{Binding BackgroundLabels}" SelectedIndex="{Binding BackgroundIndex}" /></StackPanel>
              <StackPanel Width="150" Spacing="4" Margin="0,0,12,12"><SelectableTextBlock Text="适应方式" /><ComboBox ItemsSource="{Binding FitLabels}" SelectedIndex="{Binding FitIndex}" /></StackPanel>
            </WrapPanel>
            <CheckBox Content="日漫方向（右→左）" IsChecked="{Binding RightToLeft}" />
            <StackPanel Spacing="4"><SelectableTextBlock Text="解码像素上限" /><Slider Minimum="4" Maximum="96" Value="{Binding MaxMegapixels}" /><SelectableTextBlock Text="{Binding MaxMegapixelsLabel}" /></StackPanel>
            <StackPanel Spacing="4"><SelectableTextBlock Text="图像内存预算（包含解码缓冲、预读与动画）" TextWrapping="Wrap" /><Slider Minimum="64" Maximum="1536" Value="{Binding PageCacheMegabytes}" /><SelectableTextBlock Text="{Binding PageCacheLabel}" /></StackPanel>
            <StackPanel Spacing="4"><SelectableTextBlock Text="封面解码宽度" /><Slider Minimum="160" Maximum="1024" Value="{Binding CoverDecodeWidth}" /><SelectableTextBlock Text="{Binding CoverDecodeLabel}" /></StackPanel>
          </StackPanel>
        </Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem><TabItem.Header><TextBlock Text="资料库" FontSize="14" /></TabItem.Header><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,0,12">
<Border Classes="tile">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <SelectableTextBlock Text="本地数据源" Classes="h2" />
              <Button Grid.Column="1" Content="添加目录…" Click="OnAddSource" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Sources}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SourceRowViewModel">
                  <Border Classes="row" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="Auto,12,*,Auto,Auto" ColumnSpacing="0">
                      <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="2" Spacing="2">
                        <SelectableTextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayName}" />
                        <SelectableTextBlock Classes="caption" Text="{Binding RootPath}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RootPath}" />
                        <SelectableTextBlock Classes="caption" Text="{Binding StatusText}"
                                   Foreground="{DynamicResource AppWarningBrush}" />
                      </StackPanel>
                      <Button Grid.Column="3" Content="打开" Classes="ghost" Tag="{Binding}" Click="OnOpenSource" />
                      <Button Grid.Column="4" Content="移除" Classes="ghost" Tag="{Binding}" Click="OnRemoveSource" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,4" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <StackPanel Spacing="2">
                <SelectableTextBlock Text="重新扫描全部来源" Classes="secondary" />
                <SelectableTextBlock Text="{Binding RescanStatus}" Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Content="开始扫描" Command="{Binding StartRescanCommand}"
                      IsEnabled="{Binding CanStartRescan}" VerticalAlignment="Center" />
              <Button Grid.Column="2" Content="取消" Classes="ghost" Command="{Binding CancelRescanCommand}"
                      IsVisible="{Binding IsRescanning}" VerticalAlignment="Center" />
            </Grid>
            <SelectableTextBlock Classes="caption" Text="只清除扫描缓存不会重新扫描；正常启动仍会加载缓存并对变动目录做增量更新。"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem><TabItem.Header><TextBlock Text="维护" FontSize="14" /></TabItem.Header><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,0,12">
<Border Classes="tile">
          <StackPanel Spacing="6">
            <SelectableTextBlock Text="关于" Classes="h2" />
            <SelectableTextBlock Classes="secondary" Text="{Binding DataDirectory, StringFormat='数据目录：{0}'}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              </StackPanel>
            </StackPanel>
        </Border>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Border Grid.Row="2" Padding="22,9" MinHeight="36" BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="4"><SelectableTextBlock Classes="muted" FontSize="12" Text="修改后点击保存。" TextWrapping="Wrap" />
          <SelectableTextBlock Text="{Binding DownloadStatus}" Classes="caption" TextWrapping="Wrap" />
          <ProgressBar IsVisible="{Binding IsSaving}" IsIndeterminate="True" Height="3" />
        </StackPanel>
        <Button Grid.Column="1" IsVisible="{Binding CanCancelMove}" Content="取消迁移" Command="{Binding CancelMoveCommand}" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
