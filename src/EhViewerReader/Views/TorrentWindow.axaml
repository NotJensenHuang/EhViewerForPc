<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:EhViewerReader.ViewModels"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="620"
        x:Class="EhViewerReader.Views.TorrentWindow"
        x:DataType="vm:TorrentViewModel"
        Title="{Binding Title}"
        Width="760" Height="620" MinWidth="620" MinHeight="420"
        Background="{DynamicResource AppBgBrush}"
        WindowStartupLocation="CenterOwner">
  <Grid Background="{DynamicResource AppBgBrush}" RowDefinitions="Auto,Auto,*,Auto">
    <Border Grid.Row="0" Padding="22,16,22,12" BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="3">
          <TextBlock Text="种子下载" Classes="h1" />
          <TextBlock Text="{Binding GalleryTitle}" Classes="secondary" MaxLines="1" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Subtitle}" Classes="caption" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="刷新" Command="{Binding RefreshCommand}" />
          <Button Content="关闭" Click="OnClose" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Margin="22,12,22,0" Classes="row">
      <TextBlock Classes="caption" TextWrapping="Wrap"
                 Text="种子文件由上传者提供，下载后请使用任意 BT 客户端。做种数为 0 的种子可能已无人做种。" />
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="22,12,22,12">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TorrentItemViewModel">
            <Border Classes="row" Margin="0,0,0,8">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="Bold" />
                  <TextBlock Classes="caption" Text="{Binding StatsLine}" TextWrapping="Wrap" />
                  <TextBlock Classes="caption" Text="{Binding MetaLine}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Button Classes="primary" Content="保存 .torrent" Tag="{Binding}" Click="OnSaveTorrent" />
                  <Button Content="复制链接" Tag="{Binding}" Click="OnCopyLink" />
                  <Button Content="浏览器" Classes="ghost" Tag="{Binding}" Click="OnOpenLink" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="3" Padding="22,9" MinHeight="36" BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusText}" Classes="secondary" FontSize="11" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="保存后可用任意 BT 客户端打开" Classes="muted"
                   FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
