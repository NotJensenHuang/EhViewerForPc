<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:EhViewerReader.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1320" d:DesignHeight="860"
        x:Class="EhViewerReader.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="EhViewer Reader"
        Width="1240" Height="760" MinWidth="1000" MinHeight="620"
        Background="{DynamicResource AppBgBrush}"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="208,*" Background="{DynamicResource AppBgBrush}">
    <!-- Navigation rail -->
    <Border Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12,16,12,12">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="4,0,0,16">
          <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AppAccentBrush}">
            <TextBlock Text="EH" FontSize="14" FontWeight="Bold" Foreground="#14090C"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="EhViewer Reader" FontSize="13" FontWeight="Bold" />
            <TextBlock Text="在线 + 本地 + 下载" Classes="caption" FontSize="10" />
          </StackPanel>
        </StackPanel>

        <Button Grid.Row="1" Classes="nav" Click="OnToggleSite" Margin="0,0,0,12"
                ToolTip.Tip="在 E-Hentai 与 ExHentai 之间切换">
          <Grid ColumnDefinitions="Auto,8,*,Auto" VerticalAlignment="Center">
            <Border Background="{DynamicResource AppAccentSoftBrush}" CornerRadius="6" Padding="6,2"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding SiteBadge}" FontSize="10" FontWeight="Bold"
                         Foreground="{DynamicResource AppAccentBrush}" />
            </Border>
            <TextBlock Grid.Column="2" Text="{Binding SiteLabel}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="⇄" Classes="caption" VerticalAlignment="Center" />
          </Grid>
        </Button>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding NavItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <Button Classes="nav" Classes.active="{Binding IsActive}" Tag="{Binding}" Click="OnNavClick">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Glyph}" FontSize="14" Width="18" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="3" Spacing="6">
          <Border Background="{DynamicResource AppBgAltBrush}" CornerRadius="10" Padding="10,8">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding AccountLabel}" FontSize="12" FontWeight="Bold" />
              <TextBlock Text="{Binding AccountDetail}" Classes="caption" FontSize="10" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                <Button Content="登录" Classes="ghost" FontSize="10" Padding="6,2" MinHeight="22"
                        Command="{Binding OpenSettingsCommand}" />
                <Button Content="退出" Classes="ghost" FontSize="10" Padding="6,2" MinHeight="22"
                        Command="{Binding SignOutCommand}" IsVisible="{Binding IsSignedIn}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Classes="muted" FontSize="10" HorizontalAlignment="Center"
                     Text="本地库保持只读 · 在线内容需遵守站点条款" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Content -->
    <Grid Grid.Column="1">
      <ContentControl x:Name="ContentHost" />

      <!-- Toast -->
      <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
              Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppAccentBrush}"
              BorderThickness="1" CornerRadius="10" Padding="16,9" IsVisible="{Binding ShowToast}"
              BoxShadow="0 6 24 0 #66000000">
        <TextBlock Text="{Binding ToastText}" FontSize="12" MaxWidth="620" TextWrapping="Wrap" />
      </Border>

      <!-- Busy overlay for page transitions -->
      <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Top"
                   IsVisible="{Binding Online.IsBusy}" />
    </Grid>
  </Grid>
</Window>
