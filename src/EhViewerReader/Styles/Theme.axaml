<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBgBrush" Color="#0B0D10" />
          <SolidColorBrush x:Key="AppBgAltBrush" Color="#101317" />
          <SolidColorBrush x:Key="AppSurfaceBrush" Color="#15181E" />
          <SolidColorBrush x:Key="AppCardBrush" Color="#1B1F27" />
          <SolidColorBrush x:Key="AppCardHoverBrush" Color="#222736" />
          <SolidColorBrush x:Key="AppBorderBrush" Color="#262B35" />
          <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#333A47" />
          <SolidColorBrush x:Key="AppTextBrush" Color="#F2F4F8" />
          <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#9AA3B2" />
          <SolidColorBrush x:Key="AppTextMutedBrush" Color="#9AA3B2" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="#FF6B81" />
          <SolidColorBrush x:Key="AppAccentTextBrush" Color="#14090C" />
          <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#2A1A20" />
          <SolidColorBrush x:Key="AppSuccessBrush" Color="#5AD1A0" />
          <SolidColorBrush x:Key="AppWarningBrush" Color="#F2C46D" />
          <SolidColorBrush x:Key="AppOverlayBrush" Color="#CC0B0D10" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBgBrush" Color="#F4F5F7" />
          <SolidColorBrush x:Key="AppBgAltBrush" Color="#ECEEF2" />
          <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppCardBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppCardHoverBrush" Color="#F7F8FA" />
          <SolidColorBrush x:Key="AppBorderBrush" Color="#DDE1E8" />
          <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#C6CCD6" />
          <SolidColorBrush x:Key="AppTextBrush" Color="#1A1D23" />
          <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#5A6372" />
          <SolidColorBrush x:Key="AppTextMutedBrush" Color="#596273" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="#B63650" />
          <SolidColorBrush x:Key="AppAccentTextBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#FDEDF0" />
          <SolidColorBrush x:Key="AppSuccessBrush" Color="#1F9D74" />
          <SolidColorBrush x:Key="AppWarningBrush" Color="#B77A12" />
          <SolidColorBrush x:Key="AppOverlayBrush" Color="#CCFFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <FontFamily x:Key="AppFont">Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Segoe UI, Inter</FontFamily>
      <FontFamily x:Key="AppMonoFont">Cascadia Mono, Menlo, DejaVu Sans Mono, Consolas, Noto Sans CJK SC, Microsoft YaHei UI</FontFamily>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AppBgBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10" />
  </Style>

  <Style Selector="Border.card:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Border.card:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppCardHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppCardHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Opacity" Value="0.88" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
  </Style>

  <Style Selector="Button.ghost:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppCardHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>

  <Style Selector="Button.chip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <Style Selector="Button.chip.active">
    <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="32" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="CornerRadius" Value="999" />
  </Style>

  <Style Selector="Slider">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Navigation rail -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="Button.nav:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppCardHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>

  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Online gallery card -->
  <Style Selector="Button.gallery-card">
    <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="Button.gallery-card:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppCardHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <Style Selector="ToggleButton.chip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="ToggleButton.chip:checked">
    <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Section helpers -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18" />
  </Style>

  <Style Selector="Border.row">
    <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,10" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="26" />
  </Style>
  <Style Selector="Window.compact TextBlock.nav-label"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="Window.compact StackPanel.wide-nav"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="Window.compact Button.nav"><Setter Property="Padding" Value="4,8" /></Style>
  <Style Selector="WrapPanel > Button"><Setter Property="Margin" Value="0,0,6,6" /></Style>
  <Style Selector="WrapPanel > ComboBox"><Setter Property="Margin" Value="0,0,6,6" /></Style>
  <Style Selector="Border.language-badge">
    <Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="8" /><Setter Property="Background" Value="#CC101317" />
    <Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="7,2" />
  </Style>
  <Style Selector="TextBlock.language-badge-text"><Setter Property="FontSize" Value="10" /><Setter Property="Foreground" Value="#9EC1FF" /></Style>
</Styles>
