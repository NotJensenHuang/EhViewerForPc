<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBgBrush" Color="{DynamicResource SolidBackgroundFillColorBase}" />
          <SolidColorBrush x:Key="AppBgAltBrush" Color="{DynamicResource SolidBackgroundFillColorSecondary}" />
          <SolidColorBrush x:Key="AppSurfaceBrush" Color="{DynamicResource LayerFillColorDefault}" />
          <SolidColorBrush x:Key="AppCardBrush" Color="{DynamicResource CardBackgroundFillColorDefault}" />
          <SolidColorBrush x:Key="AppCardHoverBrush" Color="{DynamicResource SubtleFillColorSecondary}" />
          <SolidColorBrush x:Key="AppBorderBrush" Color="{DynamicResource CardStrokeColorDefault}" />
          <SolidColorBrush x:Key="AppBorderStrongBrush" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="AppTextBrush" Color="{DynamicResource TextFillColorPrimary}" />
          <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{DynamicResource TextFillColorSecondary}" />
          <SolidColorBrush x:Key="AppTextMutedBrush" Color="{DynamicResource TextFillColorSecondary}" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="#FF6B81" />
          <SolidColorBrush x:Key="AppAccentTextBrush" Color="#14090C" />
          <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#2A1A20" />
          <SolidColorBrush x:Key="AppSuccessBrush" Color="#5AD1A0" />
          <SolidColorBrush x:Key="AppWarningBrush" Color="#F2C46D" />
          <SolidColorBrush x:Key="AppOverlayBrush" Color="#CC0B0D10" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBgBrush" Color="{DynamicResource SolidBackgroundFillColorBase}" />
          <SolidColorBrush x:Key="AppBgAltBrush" Color="{DynamicResource SolidBackgroundFillColorSecondary}" />
          <SolidColorBrush x:Key="AppSurfaceBrush" Color="{DynamicResource LayerFillColorDefault}" />
          <SolidColorBrush x:Key="AppCardBrush" Color="{DynamicResource CardBackgroundFillColorDefault}" />
          <SolidColorBrush x:Key="AppCardHoverBrush" Color="{DynamicResource SubtleFillColorSecondary}" />
          <SolidColorBrush x:Key="AppBorderBrush" Color="{DynamicResource CardStrokeColorDefault}" />
          <SolidColorBrush x:Key="AppBorderStrongBrush" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="AppTextBrush" Color="{DynamicResource TextFillColorPrimary}" />
          <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{DynamicResource TextFillColorSecondary}" />
          <SolidColorBrush x:Key="AppTextMutedBrush" Color="{DynamicResource TextFillColorSecondary}" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="#B63650" />
          <SolidColorBrush x:Key="AppAccentTextBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#FDEDF0" />
          <SolidColorBrush x:Key="AppSuccessBrush" Color="#1F9D74" />
          <SolidColorBrush x:Key="AppWarningBrush" Color="#B77A12" />
          <SolidColorBrush x:Key="AppOverlayBrush" Color="#CCFFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <FontFamily x:Key="AppFont">Segoe UI Variable, Segoe UI, Microsoft YaHei UI, Noto Sans CJK SC</FontFamily>
      <FontFamily x:Key="AppMonoFont">Cascadia Mono, Menlo, DejaVu Sans Mono, Consolas, Noto Sans CJK SC, Microsoft YaHei UI</FontFamily>

      <!-- Layout tokens. Pages share these values so headers, toolbars, lists
           and status bars start on the same vertical guide. -->
      <Thickness x:Key="AppPagePadding">24,16,24,0</Thickness>
      <Thickness x:Key="AppListPadding">24,0,24,20</Thickness>
      <Thickness x:Key="AppBottomBarPadding">24,0</Thickness>
      <CornerRadius x:Key="AppRowRadius">6</CornerRadius>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AppBgBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>

  <!-- Selectable text: click/drag to select, Ctrl+C to copy. Tab focus is
       suppressed so a page full of prose does not flood the tab order. -->
  <Style Selector="SelectableTextBlock">
    <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
  </Style>

  <Style Selector=":is(TextBlock).secondary">
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
  </Style>

  <Style Selector=":is(TextBlock).muted">
    <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
  </Style>

  <Style Selector=":is(TextBlock).title">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector=":is(TextBlock).caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10" />
  </Style>

  <Style Selector="Border.card:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Border.card:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppCardHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
  </Style>

  <Style Selector="Button.ghost:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppCardHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>

  <Style Selector="Button.chip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <Style Selector="Button.chip.active">
    <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

<!-- Navigation rail -->
<!-- Online gallery card -->
  <Style Selector="Button.gallery-card">
    <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="Button.gallery-card:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppCardHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <Style Selector="ToggleButton.chip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="ToggleButton.chip:checked">
    <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Section helpers -->
  <Style Selector=":is(TextBlock).h1">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector=":is(TextBlock).h2">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="18" />
  </Style>

  <Style Selector="Border.row">
    <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,10" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="26" />
  </Style>
  <!-- Explicit action rows. The global "all children of a WrapPanel" margin was
       removed because it silently combined with per-control margins; containers
       that pack buttons declare Classes="actions" instead. -->
  <Style Selector="WrapPanel.actions > :is(Button)">
    <Setter Property="Margin" Value="0,0,8,8" />
  </Style>
  <Style Selector="WrapPanel.actions > :is(ComboBox)">
    <Setter Property="Margin" Value="0,0,8,8" />
  </Style>
  <Style Selector="WrapPanel.actions > :is(CheckBox)">
    <Setter Property="Margin" Value="0,0,16,8" />
  </Style>

  <!-- Shared page chrome -->
  <Style Selector="Border.statusbar">
    <Setter Property="Padding" Value="24,6" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.page-header">
    <Setter Property="Padding" Value="24,16,24,12" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <!-- Settings: one row = label/description on the left, control on the right.
       Border.settings-group stacks rows that belong to the same heading. -->
  <Style Selector="Border.settings-row">
    <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="MinHeight" Value="56" />
  </Style>

  <Style Selector="TextBlock.group-title">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="2,4,0,0" />
  </Style>

  <!-- Category selector of the settings page: a flat, wrapping chip bar. -->
  <Style Selector="ListBox.categories">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.categories ListBoxItem">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Margin" Value="0,0,4,4" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="Border.language-badge">
    <Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="8" /><Setter Property="Background" Value="#CC101317" />
    <Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="7,2" />
  </Style>
  <Style Selector=":is(TextBlock).language-badge-text"><Setter Property="FontSize" Value="10" /><Setter Property="Foreground" Value="#9EC1FF" /></Style>
</Styles>
