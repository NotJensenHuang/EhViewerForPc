<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EhViewerForPc.ViewModels"
             xmlns:controls="using:EhViewerForPc.Controls"
             xmlns:ir="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ItemsRepeater"
             xmlns:layout="clr-namespace:Avalonia.Layout;assembly=Avalonia.Controls.ItemsRepeater"
             x:Class="EhViewerForPc.Views.DownloadsPage"
             x:DataType="vm:DownloadsViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Background="Transparent">
    <StackPanel Grid.Row="0" Spacing="10" Margin="24,16,24,10">
      <SelectableTextBlock HorizontalAlignment="Left" Text="{Binding RootPathDisplay}" Classes="caption"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RootPathDisplay}" />
      <WrapPanel Orientation="Horizontal" Classes="actions">
        <Button Content="全部开始" Classes="accent" Command="{Binding StartAllCommand}" />
        <Button Content="全部暂停" Command="{Binding PauseAllCommand}" />
        <Button Content="清除已完成" Command="{Binding ClearFinishedCommand}" />
        <Button Content="打开目录" Command="{Binding OpenRootCommand}" />
      </WrapPanel>
    </StackPanel>

    <TabControl Grid.Row="1" Margin="24,0,24,10">
      <TabItem><TabItem.Header><TextBlock Text="画廊下载" FontSize="14" /></TabItem.Header>
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
          <StackPanel Spacing="8">
            <SelectableTextBlock Text="{Binding StatusText}" Classes="secondary" TextWrapping="Wrap" />
            <StackPanel IsVisible="{Binding !HasTasks}" Spacing="8">
              <SelectableTextBlock Text="还没有下载任务" Classes="h2" />
              <WrapPanel Classes="actions">
                <Button Content="浏览作品" Click="OnBrowse" />
                <Button Content="设置下载目录" Click="OnSettings" />
              </WrapPanel>
            </StackPanel>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ir:ItemsRepeater ItemsSource="{Binding Tasks}">
            <ir:ItemsRepeater.Layout><layout:StackLayout /></ir:ItemsRepeater.Layout>
<ir:ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:DownloadTaskViewModel">
                <Border Classes="row" Margin="0,0,0,8">
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="暂停" Command="{Binding PauseCommand}" IsEnabled="{Binding CanPause}" />
                      <MenuItem Header="继续 / 重试" Command="{Binding ResumeCommand}" IsEnabled="{Binding CanResume}" />
                      <MenuItem Header="打开目录" Command="{Binding OpenFolderCommand}" />
                      <Separator />
                      <MenuItem Header="移除任务（保留文件）" Command="{Binding RemoveCommand}" />
                      <MenuItem Header="删除文件…" Command="{Binding RequestDeleteCommand}" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                    <StackPanel Spacing="5">
                      <SelectableTextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Title}" />
                      <WrapPanel Orientation="Horizontal">
                        <SelectableTextBlock Classes="caption" Text="{Binding GidText}" Margin="0,0,10,4" />
                        <SelectableTextBlock Classes="caption" Text="{Binding StateText}" Margin="0,0,10,4" Foreground="{Binding StateBadgeColor}" />
                        <SelectableTextBlock Classes="caption" Text="{Binding Label}" Margin="0,0,10,4" />
                        <SelectableTextBlock Classes="caption" Text="{Binding QualityText}" Margin="0,0,10,4" />
                      </WrapPanel>
                      <SelectableTextBlock Classes="caption" Text="{Binding Message}" IsVisible="{Binding HasMessage}"
                                           TextWrapping="Wrap" ToolTip.Tip="{Binding DamageDetail}" />
                      <Border IsVisible="{Binding ConfirmDelete}" BorderThickness="1" BorderBrush="{DynamicResource AppWarningBrush}" Padding="10"><StackPanel Spacing="6"><SelectableTextBlock Text="删除该任务的全部下载文件？" TextWrapping="Wrap" /><WrapPanel Classes="actions"><Button Content="删除文件" Command="{Binding DeleteFilesCommand}" /><Button Content="取消" Command="{Binding CancelDeleteCommand}" /></WrapPanel></StackPanel></Border>
<ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding Progress}" />
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <SelectableTextBlock Classes="caption" Text="{Binding ProgressText}" />
                        <SelectableTextBlock Classes="caption" Text="{Binding SizeText}" Margin="0,0,10,4" />
                        <SelectableTextBlock Classes="caption" Text="{Binding SpeedText}" IsVisible="{Binding IsRunning}"
                                             AutomationProperties.AutomationId="Downloads.Speed" AutomationProperties.Name="当前下载速度" />
                      </StackPanel>
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Classes="actions">
                      <Button Content="暂停" Command="{Binding PauseCommand}" IsVisible="{Binding CanPause}" />
                      <Button Content="继续 / 重试" Command="{Binding ResumeCommand}" IsVisible="{Binding CanResume}" />
                      <Button Content="阅读" Command="{Binding ReadCommand}" IsVisible="{Binding CanRead}"
                              ToolTip.Tip="{Binding ReadHint}" />
                      <Button Content="目录" Command="{Binding OpenFolderCommand}" />
                      <Button Content="移除" Command="{Binding RemoveCommand}" IsVisible="{Binding !IsCompleted}" />
                    </WrapPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ir:ItemsRepeater.ItemTemplate>
          </ir:ItemsRepeater></ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem><TabItem.Header><TextBlock Text="{Binding UnavailableTabTitle}" FontSize="14" /></TabItem.Header>
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
          <StackPanel Spacing="8">
            <SelectableTextBlock Classes="secondary" TextWrapping="Wrap"
                                 Text="站点明确回答「画廊不可用（可能已删除或需登录）」的任务会移到这里：不再自动开始或重试，已下载的页面、目录和阅读进度保持不变。确认画廊恢复或账号可访问后，可在任务上移除标记并继续 / 重试。" />
            <StackPanel IsVisible="{Binding !HasUnavailable}" Spacing="8">
              <SelectableTextBlock Text="没有画廊不可用的任务" Classes="h2" />
              <SelectableTextBlock Classes="secondary" TextWrapping="Wrap"
                                   Text="站点回答画廊不可用时，任务会自动移到这里，便于以后恢复或清理。" />
            </StackPanel>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ir:ItemsRepeater ItemsSource="{Binding UnavailableTasks}">
              <ir:ItemsRepeater.Layout><layout:StackLayout /></ir:ItemsRepeater.Layout>
              <ir:ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:DownloadTaskViewModel">
                  <Border Classes="row" Margin="0,0,0,8">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="打开目录" Command="{Binding OpenFolderCommand}" />
                        <MenuItem Header="移除画廊不可用标记" Command="{Binding UnmarkUnavailableCommand}" />
                        <Separator />
                        <MenuItem Header="移除任务（保留文件）" Command="{Binding RemoveCommand}" />
                        <MenuItem Header="删除文件…" Command="{Binding RequestDeleteCommand}" IsEnabled="{Binding CanDeleteFiles}" />
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                      <StackPanel Spacing="5">
                        <SelectableTextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                             ToolTip.Tip="{Binding Title}" />
                        <WrapPanel Orientation="Horizontal">
                          <SelectableTextBlock Classes="caption" Text="{Binding GidText}" Margin="0,0,10,4" />
                          <SelectableTextBlock Classes="caption" Text="画廊不可用" Margin="0,0,10,4" />
                          <SelectableTextBlock Classes="caption" Text="{Binding Label}" Margin="0,0,10,4" />
                          <SelectableTextBlock Classes="caption" Text="{Binding QualityText}" Margin="0,0,10,4" />
                        </WrapPanel>
                        <SelectableTextBlock Classes="caption" Text="{Binding Message}" TextWrapping="Wrap" />
                        <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding Progress}" />
                        <WrapPanel Orientation="Horizontal">
                          <SelectableTextBlock Classes="caption" Text="{Binding ProgressText}" Margin="0,0,10,0" />
                          <SelectableTextBlock Classes="caption" Text="{Binding DamageText}" IsVisible="{Binding HasDamage}"
                                               Foreground="{DynamicResource AppWarningBrush}" />
                        </WrapPanel>
                      </StackPanel>
                      <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Classes="actions">
                        <Button Content="阅读" Command="{Binding ReadCommand}" IsVisible="{Binding CanRead}"
                                ToolTip.Tip="{Binding ReadHint}" />
                        <Button Content="目录" Command="{Binding OpenFolderCommand}" />
                        <Button Content="移除标记" Command="{Binding UnmarkUnavailableCommand}"
                                ToolTip.Tip="回到画廊下载队列，可继续 / 重试" />
                        <Button Content="移除" Command="{Binding RemoveCommand}" />
                      </WrapPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ir:ItemsRepeater.ItemTemplate>
            </ir:ItemsRepeater>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem><TabItem.Header><TextBlock Text="已完成" FontSize="14" /></TabItem.Header>
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <Button Content="清空记录（保留文件）" Command="{Binding ClearArchiveCommand}" HorizontalAlignment="Right" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ir:ItemsRepeater ItemsSource="{Binding Archive}">
            <ir:ItemsRepeater.Layout><layout:StackLayout /></ir:ItemsRepeater.Layout>
<ir:ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:DownloadArchiveViewModel">
                <Border Classes="row" Margin="0,0,0,6">
                  <controls:AdaptiveGrid Breakpoint="520" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="8">
                    <StackPanel Spacing="3">
                      <SelectableTextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                      <WrapPanel Orientation="Horizontal">
                        <SelectableTextBlock Classes="caption" Text="{Binding GidText}" Margin="0,0,10,4" />
                        <SelectableTextBlock Classes="caption" Text="{Binding PagesText}" Margin="0,0,10,4" />
                        <SelectableTextBlock Classes="caption" Text="{Binding SizeText}" Margin="0,0,10,4" />
                        <SelectableTextBlock Classes="caption" Text="{Binding FinishedText}" Margin="0,0,10,4" />
                      </WrapPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="打开目录" Command="{Binding OpenFolderCommand}"
                            VerticalAlignment="Center" />
                  </controls:AdaptiveGrid>
                </Border>
              </DataTemplate>
            </ir:ItemsRepeater.ItemTemplate>
          </ir:ItemsRepeater></ScrollViewer>
          <SelectableTextBlock Grid.Row="1" Text="暂无已完成记录" Classes="secondary" IsVisible="{Binding !HasArchive}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </TabItem>
      <TabItem><TabItem.Header><TextBlock Text="归档传输" FontSize="14" /></TabItem.Header>
        <ListBox ItemsSource="{Binding ArchiveTransfers}">
          <ListBox.ItemTemplate><DataTemplate x:DataType="vm:ArchiveViewModel"><StackPanel Spacing="6" Margin="8"><TextBlock Text="{Binding GalleryTitle}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" /><ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" /><Button Content="查看 / 管理" Tag="{Binding}" Click="OnArchive" HorizontalAlignment="Left" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Classes="statusbar">
      <SelectableTextBlock Text="{Binding ActiveText}" Classes="secondary" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</UserControl>
