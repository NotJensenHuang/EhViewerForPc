<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:EhViewerForPc.ViewModels"
        xmlns:controls="using:EhViewerForPc.Controls"
        xmlns:ir="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ItemsRepeater"
        xmlns:layout="clr-namespace:Avalonia.Layout;assembly=Avalonia.Controls.ItemsRepeater"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="860"
        x:Class="EhViewerForPc.Views.ReaderPage"
        x:DataType="vm:ReaderViewModel"
        Background="{Binding BackgroundBrush}">
  <!-- The work title and the reading commands live in the shell header; this
       page is the canvas plus one compact progress row. -->
  <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,Auto" Background="{Binding BackgroundBrush}">
    <Grid Grid.Row="0" SizeChanged="OnCanvasSizeChanged">
      <controls:ZoomPanView x:Name="SingleView"
                           IsVisible="{Binding ShowSingleView}"
                           Request="{Binding SingleRequest}"
                           PreloadRequest="{Binding PreloadRequest}"
                           TranslationOverlay="{Binding ActiveTranslationOverlay}"
                           FitMode="{Binding FitMode}"
                           RightToLeft="False"
                           MaxMegapixels="{Binding MaxMegapixels}"
                           MaxDimension="{Binding MaxDimension}"
                           AutomationProperties.AutomationId="Reader.PageImage"
                           ContextRequested="OnImageContextRequested"
                           PageTurnRequested="OnPageTurnRequested" />
      <StackPanel IsVisible="{Binding ShowSingleMissingPage}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="420">
        <SelectableTextBlock Text="{Binding MissingPageText}"
                             HorizontalAlignment="Center" IsHitTestVisible="False"
                             Foreground="{DynamicResource AppWarningBrush}" FontSize="16"
                             AutomationProperties.AutomationId="Reader.MissingPage" />
        <!-- 重下进度：有总长度时显示百分比，没有时用不确定态，绝不留下「没有反应」的空窗。 -->
        <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding RetryProgress}"
                     IsIndeterminate="{Binding IsRetryProgressIndeterminate}"
                     IsVisible="{Binding ShowRetryProgress}" MaxWidth="360"
                     AutomationProperties.AutomationId="Reader.RetryProgress" />
        <SelectableTextBlock Text="{Binding RetryStatusText}" IsVisible="{Binding HasRetryStatus}"
                             HorizontalAlignment="Center" Classes="caption" TextWrapping="Wrap"
                             AutomationProperties.AutomationId="Reader.RetryStatus" />
        <Button Content="重新下载本页" Command="{Binding RetryCurrentCommand}"
                IsVisible="{Binding CanRedownload}" IsEnabled="{Binding !IsRetrying}"
                HorizontalAlignment="Center"
                ToolTip.Tip="按原始页号从在线画廊重新抓取这一页"
                AutomationProperties.Name="重新下载本页" />
      </StackPanel>

      <ScrollViewer x:Name="ContinuousScroll"
                    IsVisible="{Binding IsContinuousMode}"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="0,8,0,24"
                    ScrollChanged="OnScrollChanged">
        <ir:ItemsRepeater ItemsSource="{Binding ContinuousItems}">
          <ir:ItemsRepeater.Layout>
            <layout:StackLayout Spacing="0" />
          </ir:ItemsRepeater.Layout>
          <ir:ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:ContinuousPageItem">
              <Border Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}"
                      HorizontalAlignment="Center" Background="{DynamicResource AppBgAltBrush}">
                <Grid>
                  <controls:AsyncImage Source="{Binding Request}" TranslationOverlay="{Binding TranslationOverlay}"
                                       AutomationProperties.AutomationId="Reader.PageImage" ContextRequested="OnImageContextRequested"
                                       Stretch="Uniform" Animate="True" IsVisible="{Binding !IsMissing}" />
                  <StackPanel IsVisible="{Binding IsMissing}" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Spacing="10" MaxWidth="320">
                    <SelectableTextBlock Text="{Binding MissingPageText}"
                                         Foreground="{DynamicResource AppWarningBrush}" FontSize="16"
                                         HorizontalAlignment="Center" />
                    <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding RetryProgress}"
                                 IsIndeterminate="{Binding IsRetryProgressIndeterminate}"
                                 IsVisible="{Binding IsRetrying}" MinWidth="160" MaxWidth="240" />
                    <SelectableTextBlock Text="{Binding RetryStatusText}" IsVisible="{Binding HasRetryStatus}"
                                         Classes="caption" TextWrapping="Wrap" HorizontalAlignment="Center" />
                    <Button Content="重新下载本页" Command="{Binding RetryCommand}"
                            CommandParameter="{Binding Number}"
                            IsVisible="{Binding CanRetry}" IsEnabled="{Binding !IsRetrying}"
                            HorizontalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ir:ItemsRepeater.ItemTemplate>
        </ir:ItemsRepeater>
      </ScrollViewer>

      <ScrollViewer x:Name="HorizontalScroll"
                    IsVisible="{Binding IsHorizontalMode}"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    Padding="0,8,0,8"
                    ScrollChanged="OnScrollChanged"
                    PointerWheelChanged="OnHorizontalWheel">
        <ir:ItemsRepeater ItemsSource="{Binding HorizontalDisplayItems}">
          <ir:ItemsRepeater.Layout>
            <layout:StackLayout Orientation="Horizontal" Spacing="0" />
          </ir:ItemsRepeater.Layout>
          <ir:ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:ContinuousPageItem">
              <Border Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}"
                      Background="{DynamicResource AppBgAltBrush}">
                <Grid>
                  <controls:AsyncImage Source="{Binding Request}" TranslationOverlay="{Binding TranslationOverlay}"
                                       AutomationProperties.AutomationId="Reader.PageImage" ContextRequested="OnImageContextRequested"
                                       Stretch="Uniform" Animate="True" IsVisible="{Binding !IsMissing}" />
                  <StackPanel IsVisible="{Binding IsMissing}" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Spacing="10" MaxWidth="320">
                    <SelectableTextBlock Text="{Binding MissingPageText}"
                                         Foreground="{DynamicResource AppWarningBrush}" FontSize="16"
                                         HorizontalAlignment="Center" />
                    <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding RetryProgress}"
                                 IsIndeterminate="{Binding IsRetryProgressIndeterminate}"
                                 IsVisible="{Binding IsRetrying}" MinWidth="160" MaxWidth="240" />
                    <SelectableTextBlock Text="{Binding RetryStatusText}" IsVisible="{Binding HasRetryStatus}"
                                         Classes="caption" TextWrapping="Wrap" HorizontalAlignment="Center" />
                    <Button Content="重新下载本页" Command="{Binding RetryCommand}"
                            CommandParameter="{Binding Number}"
                            IsVisible="{Binding CanRetry}" IsEnabled="{Binding !IsRetrying}"
                            HorizontalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ir:ItemsRepeater.ItemTemplate>
        </ir:ItemsRepeater>
      </ScrollViewer>

      <Border Classes="panel" Padding="22,16" HorizontalAlignment="Center" VerticalAlignment="Center"
              IsVisible="{Binding IsLoadingDimensions}" MaxWidth="380">
        <StackPanel Spacing="10">
          <SelectableTextBlock Text="正在测量页面尺寸" FontWeight="Bold" />
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding DimensionProgress}" Height="6" />
          <SelectableTextBlock Classes="muted" FontSize="12"
                     Text="正在准备连续阅读…" />
        </StackPanel>
      </Border>

      <Border Background="#CC000000" CornerRadius="8" Padding="14,8" HorizontalAlignment="Center"
              VerticalAlignment="Top" Margin="0,14,0,0" IsVisible="{Binding ShowRestoreHint}">
        <SelectableTextBlock Text="{Binding RestoreHint}" Foreground="#F2F4F8" FontSize="12" />
      </Border>

      <!-- 沉浸模式保留退出入口。 -->
      <Button x:Name="ImmersiveExit" Content="退出沉浸（Esc）" IsVisible="False"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"
              Click="OnExitImmersive" ToolTip.Tip="恢复导航与页头（Esc）" />
    </Grid>

      <Border x:Name="TranslationPanel" Grid.Column="1" IsVisible="{Binding IsTranslationOpen}" Width="320"
              Padding="12" BorderThickness="1,0,0,0"
              Background="{DynamicResource AppBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
              AutomationProperties.AutomationId="Reader.TranslationPanel">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" VerticalAlignment="Center">
            <SelectableTextBlock Text="本页翻译" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="取消" Command="{Binding CancelTranslationCommand}"
                    IsVisible="{Binding IsTranslationRunning}"
                    AutomationProperties.AutomationId="Reader.CancelTranslation" AutomationProperties.Name="取消翻译" />
            <Button Grid.Column="2" Content="关闭" Command="{Binding CloseTranslationPanelCommand}"
                    AutomationProperties.AutomationId="Reader.CloseTranslation" AutomationProperties.Name="关闭翻译面板" />
          </Grid>
          <StackPanel Grid.Row="1" Spacing="8">
            <SelectableTextBlock Text="{Binding TranslationStatus}" TextWrapping="Wrap" Classes="secondary"
                                 AutomationProperties.AutomationId="Reader.TranslationStatus" />
            <ProgressBar IsVisible="{Binding IsTranslationRunning}" IsIndeterminate="True" Height="4" />
            <Button Content="打开翻译设置" Click="OnMangaTranslationSettings" IsVisible="{Binding ShowTranslationSettings}"
                    AutomationProperties.AutomationId="Reader.OpenTranslationSettings" />
          </StackPanel>
          <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <SelectableTextBlock Text="{Binding TranslationText}" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="Reader.TranslationText" />
          </ScrollViewer>
        </Grid>
      </Border>

    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,1,0,0" Padding="16,8" MinHeight="40">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,10,*,10,Auto,14,Auto,Auto" RowSpacing="4">
        <Button Grid.Column="0" Content="上一页" Command="{Binding PrevPageCommand}" />
        <Slider Grid.Column="2" Minimum="1" Maximum="{Binding SliderMaximum}" Value="{Binding SliderValue}"
                VerticalAlignment="Center" IsEnabled="{Binding HasPages}" AutomationProperties.Name="阅读进度" />
        <Button Grid.Column="4" Content="下一页" Command="{Binding NextPageCommand}" />
        <SelectableTextBlock Grid.Column="6" Text="{Binding PageLabel}" Classes="secondary" FontSize="12"
                   FontFamily="{DynamicResource AppMonoFont}" VerticalAlignment="Center" MinWidth="64"
                   TextAlignment="Right" />
        <StackPanel Grid.Column="7" Orientation="Horizontal" Margin="10,0,0,0" Spacing="6"
                    IsVisible="{Binding HasTranslationText}">
          <Button Content="{Binding TranslationImageButtonText}" Command="{Binding ToggleTranslationImageCommand}"
                  IsVisible="{Binding HasImageTranslation}" AutomationProperties.AutomationId="Reader.ToggleTranslationImage" />
          <Button Content="双语文本" Command="{Binding OpenTranslationTextCommand}"
                  AutomationProperties.AutomationId="Reader.OpenTranslationText" />
        </StackPanel>
        <DockPanel Grid.Row="1" Grid.ColumnSpan="8">
          <ToggleButton x:Name="AutoTranslationToggle" DockPanel.Dock="Left" Content="自动翻译"
                        IsChecked="{Binding AutoTranslateReaderPages, Mode=TwoWay}"
                        AutomationProperties.AutomationId="Reader.AutoTranslate"
                        AutomationProperties.Name="自动翻译"
                        ToolTip.Tip="自动翻译当前可见的静态漫画页" />
          <Button DockPanel.Dock="Right" Content="打开翻译设置" Click="OnMangaTranslationSettings"
                  IsVisible="{Binding ShowAutomaticTranslationSettings}"
                  AutomationProperties.AutomationId="Reader.OpenAutoTranslationSettings" />
          <TextBlock Text="{Binding AutomaticTranslationStatus}" Classes="secondary" FontSize="12"
                     VerticalAlignment="Center" Margin="10,0" TextWrapping="Wrap" MaxLines="2"
                     AutomationProperties.AutomationId="Reader.AutoTranslationStatus" />
        </DockPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
