<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EhViewerForPc.ViewModels"
             xmlns:models="using:EhViewerForPc.Core.Models"
             xmlns:controls="using:EhViewerForPc.Controls"
             x:Class="EhViewerForPc.Views.BookmarksView" x:DataType="vm:BookmarksViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid RowDefinitions="Auto,*,Auto">
    <WrapPanel Classes="actions" Margin="0,0,0,12" IsEnabled="{Binding IsIdle}">
      <Button Content="添加当前列表" Command="{Binding AddCurrentCommand}" Classes="accent" AutomationProperties.AutomationId="Bookmarks.Add" />
      <Button Content="导入书签" Click="OnImport" AutomationProperties.AutomationId="Bookmarks.Import" />
      <Button Content="导出书签" Click="OnExport" AutomationProperties.AutomationId="Bookmarks.Export" />
    </WrapPanel>
    <controls:AdaptiveGrid Grid.Row="1" Breakpoint="600" ColumnDefinitions="*,300" RowSpacing="12" ColumnSpacing="20" Margin="0,0,0,16">
      <Grid>
      <SelectableTextBlock Text="尚无书签，可添加当前列表或导入备份。" TextWrapping="Wrap"
                           Classes="secondary" IsVisible="{Binding !HasItems}" Margin="0,8" />
      <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" MinHeight="100" MaxHeight="320" IsVisible="{Binding HasItems}"
               AutomationProperties.Name="书签列表" DoubleTapped="OnOpenSelected">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="models:SavedSearchEntry">
            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="8,10" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      </Grid>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="Bookmarks.Editor">
        <StackPanel Spacing="12" IsEnabled="{Binding IsIdle}">
          <SelectableTextBlock Text="双击书签或点击“打开”执行搜索。" TextWrapping="Wrap" Classes="secondary" />
          <StackPanel Spacing="10" IsEnabled="{Binding HasSelection}">
            <TextBlock Text="名称" />
            <TextBox Text="{Binding EditName}" AutomationProperties.Name="书签名称" />
            <TextBlock Text="关键词" />
            <TextBox Text="{Binding EditQuery}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" AutomationProperties.Name="书签关键词" />
            <WrapPanel Classes="actions">
              <Button Content="打开" Command="{Binding OpenCommand}" Classes="accent" AutomationProperties.AutomationId="Bookmarks.Open" />
              <Button Content="保存名称和关键词" Command="{Binding SaveEditCommand}" />
              <Button Content="编辑完整搜索条件" Command="{Binding EditOptionsCommand}" />
            </WrapPanel>
            <WrapPanel Classes="actions">
              <Button Content="上移" Command="{Binding MoveUpCommand}" />
              <Button Content="下移" Command="{Binding MoveDownCommand}" />
              <Button Content="删除" Command="{Binding DeleteCommand}" />
            </WrapPanel>
          </StackPanel>
          <SelectableTextBlock Text="支持原版 .db 备份及 JSON；导入时保留现有书签，同名项跳过。" TextWrapping="Wrap" Classes="caption" />
        </StackPanel>
      </ScrollViewer>
    </controls:AdaptiveGrid>
    <Border Grid.Row="2" Classes="statusbar">
      <Grid ColumnDefinitions="*,Auto">
        <SelectableTextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Classes="secondary" FontSize="12" />
        <TextBlock Grid.Column="1" Text="{Binding Items.Count, StringFormat='{}{0} 项'}" Margin="12,0,0,0" Classes="caption" />
      </Grid>
    </Border>
  </Grid>
  </ScrollViewer>
</UserControl>
