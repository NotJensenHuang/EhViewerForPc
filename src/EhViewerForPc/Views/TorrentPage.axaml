<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:EhViewerForPc.ViewModels"
        xmlns:controls="using:EhViewerForPc.Controls"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="620"
        x:Class="EhViewerForPc.Views.TorrentPage"
        x:DataType="vm:TorrentViewModel"
        Background="Transparent">
  <Grid Background="Transparent" RowDefinitions="Auto,Auto,*,Auto">
    <!-- Page identity comes from the shell ("种子"); this is the work context. -->
    <Border Grid.Row="0" Classes="page-header">
      <controls:AdaptiveGrid Breakpoint="620" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="8">
        <StackPanel Spacing="3">
          <SelectableTextBlock Text="{Binding GalleryTitle}" FontWeight="SemiBold" MaxLines="1"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding GalleryTitle}" />
          <SelectableTextBlock Text="{Binding Subtitle}" Classes="caption" TextWrapping="Wrap" />
        </StackPanel>
        <WrapPanel Grid.Column="1" Orientation="Horizontal" Classes="actions" VerticalAlignment="Center">
          <Button Content="刷新" Command="{Binding RefreshCommand}" />
          <Button Content="关闭" Click="OnClose" />
        </WrapPanel>
      </controls:AdaptiveGrid>
    </Border>

    <Border Grid.Row="1" Margin="24,12,24,0" Classes="row">
      <SelectableTextBlock Classes="caption" TextWrapping="Wrap"
                 Text="使用 BT 客户端打开种子。" />
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="24,12,24,12">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TorrentItemViewModel">
            <Border Classes="row" Margin="0,0,0,8">
              <controls:AdaptiveGrid ColumnDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="12">
                <StackPanel Spacing="4">
                  <SelectableTextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="Bold" />
                  <SelectableTextBlock Classes="caption" Text="{Binding StatsLine}" TextWrapping="Wrap" />
                  <SelectableTextBlock Classes="caption" Text="{Binding MetaLine}" TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Classes="actions">
                  <Button Classes="accent" Content="保存 .torrent" Tag="{Binding}" Click="OnSaveTorrent" />
                  <Button Content="复制链接" Tag="{Binding}" Click="OnCopyLink" />
                  <Button Content="浏览器" Classes="ghost" Tag="{Binding}" Click="OnOpenLink" />
                </WrapPanel>
              </controls:AdaptiveGrid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <SelectableTextBlock Grid.Row="2" Text="暂无可显示的种子" Classes="secondary" IsVisible="{Binding ShowEmpty}"
               HorizontalAlignment="Center" VerticalAlignment="Center" />

    <Border Grid.Row="3" Classes="statusbar">
      <SelectableTextBlock Text="{Binding StatusText}" Classes="secondary" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</UserControl>
