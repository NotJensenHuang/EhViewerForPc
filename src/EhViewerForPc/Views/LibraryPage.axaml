<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EhViewerForPc.ViewModels"
             xmlns:controls="using:EhViewerForPc.Controls"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:ir="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ItemsRepeater"
             xmlns:layout="clr-namespace:Avalonia.Layout;assembly=Avalonia.Controls.ItemsRepeater"
             x:Class="EhViewerForPc.Views.LibraryPage"
             x:DataType="vm:MainViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Background="Transparent">
    <!-- Toolbar: search is the primary row; sort and language form one group
         that moves under the search box when the row gets narrow. -->
    <StackPanel Grid.Row="0" Spacing="10" Margin="24,16,24,8">
      <controls:AdaptiveGrid Breakpoint="760" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="10">
        <Grid>
          <TextBox x:Name="SearchBox" Text="{Binding SearchText}" PlaceholderText="搜索标题、文件夹或 GID（Ctrl+F）" />
          <Button Content="清除" Classes="ghost" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,4,0" FontSize="12" Click="OnClearSearch"
                  IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Grid>
        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="以图搜图" Click="OnImageSearch" AutomationProperties.AutomationId="Library.ImageSearch" Margin="0,0,8,4" />
          <Button Content="补齐缺页" Command="{Binding FillMissingPagesCommand}" AutomationProperties.AutomationId="Library.FillMissing"
                  ToolTip.Tip="补齐当前列表中所有版本的缺页，已有任务复用" Margin="0,0,8,4" />
          <ComboBox Width="132" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                    AutomationProperties.Name="排序方式" Margin="0,0,8,4">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SortOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox Width="132" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}"
                    AutomationProperties.Name="语言筛选" Margin="0,0,0,4">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LanguageOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </WrapPanel>
      </controls:AdaptiveGrid>

      <ItemsControl ItemsSource="{Binding FilterOptions}" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FilterOption">
            <Button Classes="chip" Classes.active="{Binding IsActive}" Content="{Binding Label}" Margin="0,0,8,6"
                    Tag="{Binding}" Click="OnFilterClick" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Expander Header="查看补页失败明细" IsVisible="{Binding HasRepairFailures}" HorizontalAlignment="Stretch">
        <ScrollViewer MaxHeight="140" HorizontalScrollBarVisibility="Disabled">
          <SelectableTextBlock Text="{Binding RepairFailureDetails}" TextWrapping="Wrap" />
        </ScrollViewer>
      </Expander>
    </StackPanel>

    <!-- Grid -->
    <Grid Grid.Row="1">
      <ScrollViewer x:Name="LibraryScroll" VerticalScrollBarVisibility="Auto"
                    ScrollChanged="OnLibraryScrollChanged">
        <Border Padding="24,6,24,20">
          <ir:ItemsRepeater x:Name="LibraryRepeater" ItemsSource="{Binding Galleries}">
            <ir:ItemsRepeater.Layout>
              <layout:UniformGridLayout MinItemWidth="196" MinItemHeight="352"
                                        MinColumnSpacing="14" MinRowSpacing="14"
                                        ItemsStretch="Fill" />
            </ir:ItemsRepeater.Layout>
            <ir:ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:GalleryItemViewModel">
                <Border Classes="card" Height="352" ToolTip.Tip="{Binding TooltipText}"
                        Focusable="True" Tapped="OnCardTapped" ContextRequested="OnCardContextRequested"
                        KeyDown="OnCardKeyDown">
                  <Grid RowDefinitions="248,Auto,Auto,*" RowSpacing="0">
                    <Border CornerRadius="8" ClipToBounds="True" Background="{DynamicResource AppBgAltBrush}"
                            Tapped="OnCoverTapped" ToolTip.Tip="点击封面查看详情">
                      <Grid>
                        <controls:AsyncImage Source="{Binding CoverRequest}" Stretch="UniformToFill" />

                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="8"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                          <Border Background="#B3000000" CornerRadius="6" Padding="7,2">
                            <TextBlock Text="{Binding PageCountText}" FontSize="12" Foreground="#F2F4F8" />
                          </Border>
                          <Border Background="#CC3A1D24" CornerRadius="6" Padding="7,2"
                                  IsVisible="{Binding HasMultipleVersions}" Tapped="OnVersionsClick"
                                  ToolTip.Tip="{Binding VersionSummary}">
                            <TextBlock Text="{Binding VersionBadge}" FontSize="12" Foreground="#FFB3BF" />
                          </Border>
                        </StackPanel>

                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                Background="#CC3A1D24" CornerRadius="6" Padding="7,2"
                                IsVisible="{Binding IsIncomplete}">
                          <TextBlock Text="{Binding IncompleteText}" FontSize="12" Foreground="#FFB3BF" />
                        </Border>

                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,44"
                                Background="#B3000000" CornerRadius="6" Padding="7,2"
                                IsVisible="{Binding IsFavorite}">
                          <TextBlock Text="♥ 收藏" FontSize="12" Foreground="#FF6B81" />
                        </Border>

                        <Border Classes="language-badge" IsVisible="{Binding HasLanguages}">
                          <TextBlock Classes="language-badge-text" Text="{Binding LanguageText}" />
                        </Border>

                        <!-- Download overlay: never intercepts clicks on the cover buttons. -->
                        <Border Background="#A6000000" IsVisible="{Binding HasActiveDownload}"
                                IsHitTestVisible="False"
                                AutomationProperties.Name="{Binding DownloadAutomationText}">
                          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                            <ui:FAProgressRing Width="34" Height="34" IsActive="True"
                                               IsIndeterminate="{Binding IsDownloadIndeterminate}"
                                               Minimum="0" Maximum="1" Value="{Binding DownloadFraction}" />
                            <TextBlock Text="{Binding DownloadStatusText}" FontSize="12" Foreground="#F2F4F8"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="152" />
                            <TextBlock Text="{Binding DownloadSpeedText}" IsVisible="{Binding ShowDownloadSpeed}" FontSize="12" Foreground="#F2F4F8"
                                       TextAlignment="Center" AutomationProperties.AutomationId="Library.DownloadSpeed" AutomationProperties.Name="当前下载速度" />
                          </StackPanel>
                        </Border>

                        <ProgressBar VerticalAlignment="Bottom" Height="3" Minimum="0" Maximum="1"
                                     Value="{Binding ProgressFraction}" />
                      </Grid>
                    </Border>

                    <Border Grid.Row="0" Background="{DynamicResource AppBgBrush}" CornerRadius="4"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                            AutomationProperties.AutomationId="Library.ReadSurface">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                      <Button Content="阅读" FontWeight="SemiBold" FontSize="13" MinHeight="32" Padding="12,4"
                              IsEnabled="{Binding CanRead}" Click="OnReadCard"
                              AutomationProperties.Name="阅读此作品" AutomationProperties.AutomationId="Library.Read" />
                      <Button Content="继续下载" FontSize="13" MinHeight="32" Padding="10,4" IsVisible="{Binding IsIncomplete}"
                              IsEnabled="{Binding CanContinueDownload}" Click="OnContinueDownload" ToolTip.Tip="{Binding FolderPath}"
                              AutomationProperties.AutomationId="Library.ContinueDownload" />
                      </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="1" Classes="title" Text="{Binding Title}" TextWrapping="Wrap"
                               MaxLines="2" MinHeight="40" Margin="0,8,0,0" />
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,6,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="caption" Text="{Binding GidText, StringFormat='#{0}'}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Classes="caption" Text="{Binding ProgressText}" />
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ir:ItemsRepeater.ItemTemplate>
          </ir:ItemsRepeater>
        </Border>
      </ScrollViewer>

      <!-- Welcome -->
      <Border Classes="panel" MaxWidth="580" Margin="16" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
              IsVisible="{Binding ShowWelcome}">
        <StackPanel Spacing="12">
          <SelectableTextBlock Text="选择 EhViewer 下载目录" FontSize="20" FontWeight="Bold" />
          <SelectableTextBlock Classes="secondary" TextWrapping="Wrap"
                     Text="选择包含画廊文件夹的目录。" />
          <SelectableTextBlock Classes="caption" FontSize="12" TextWrapping="Wrap" Text="{Binding StatusText}" />
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
            <Button Classes="accent" Content="选择资料库" Click="OnChooseFolder" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Initial scan -->
      <Border Classes="panel" MaxWidth="380" MinWidth="260" Padding="24,18" HorizontalAlignment="Center" VerticalAlignment="Center"
              IsVisible="{Binding ShowInitialScan}">
        <StackPanel Spacing="10">
          <SelectableTextBlock Text="正在扫描资料库…" FontWeight="Bold" />
          <ProgressBar IsIndeterminate="True" Height="4" />
          <SelectableTextBlock Text="{Binding StatusText}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <SelectableTextBlock Classes="muted" FontSize="12"
                     Text="正在扫描文件，可随时取消。" />
        </StackPanel>
      </Border>

      <!-- No results -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                  IsVisible="{Binding ShowNoResults}">
        <SelectableTextBlock Text="没有可显示的画廊" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
        <SelectableTextBlock Classes="secondary" Text="资料库为空，或调整搜索词/筛选条件" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- Status bar: scan state and counts share one line. The redundant
         "设置" shortcut was removed; settings lives in the rail. -->
    <Border Grid.Row="2" x:Name="StatusBar" Classes="statusbar" ToolTip.Tip="{Binding RootDisplay}">
      <Grid ColumnDefinitions="*,Auto,14,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" ClipToBounds="True">
          <SelectableTextBlock Text="{Binding StatusText}" Classes="secondary" FontSize="12"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <ProgressBar Width="80" Height="4" Minimum="0" Maximum="100" Value="{Binding ScanPercent}"
                       IsVisible="{Binding IsScanning}" VerticalAlignment="Center" />
          <Button Content="取消扫描" Classes="ghost" FontSize="12" Padding="8,2" MinHeight="24"
                  Command="{Binding CancelScanCommand}" IsVisible="{Binding IsScanning}" VerticalAlignment="Center" />
        </StackPanel>
        <SelectableTextBlock Grid.Column="1" Classes="muted" FontSize="12" VerticalAlignment="Center"
                             Text="{Binding FilteredCount, StringFormat='显示 {0:N0}'}" />
        <SelectableTextBlock Grid.Column="3" Classes="muted" FontSize="12" VerticalAlignment="Center"
                             Text="{Binding TotalGalleryCount, StringFormat='共 {0:N0}'}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
