<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EhViewerForPc.ViewModels"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:controls="using:EhViewerForPc.Controls"
        x:Class="EhViewerForPc.Views.MainWindow" x:DataType="vm:ShellViewModel"
        Title="EhViewer for PC" Width="1240" Height="760" MinWidth="540" MinHeight="420"
        Background="{DynamicResource AppBgBrush}" WindowStartupLocation="CenterScreen"
        WindowDecorations="Full" ExtendClientAreaToDecorationsHint="False">
  <Grid Background="{DynamicResource AppBgBrush}">
    <ui:FANavigationView x:Name="Navigation" PaneTitle="EhViewer for PC"
                         PaneDisplayMode="Auto" OpenPaneLength="224" CompactPaneLength="48"
                         ExpandedModeThresholdWidth="920" CompactModeThresholdWidth="640"
                         IsSettingsVisible="False" IsBackButtonVisible="True"
                         IsBackEnabled="{Binding CanGoBack, ElementName=ContentHost}"
                         MenuItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         BackRequested="OnGoBack" ItemInvoked="OnNavigationItemInvoked">
      <ui:FANavigationView.Resources>
        <Thickness x:Key="NavigationViewHeaderMargin">24,8,24,8</Thickness>
        <Thickness x:Key="NavigationViewMinimalHeaderMargin">8,4,16,4</Thickness>
      </ui:FANavigationView.Resources>
      <ui:FANavigationView.MenuItemTemplate>
        <DataTemplate x:DataType="vm:NavItem">
          <ui:FANavigationViewItem Content="{Binding Label}" IconSource="{Binding IconSource}"
                                   IsEnabled="{Binding IsEnabled}"
                                   AutomationProperties.Name="{Binding Label}" />
        </DataTemplate>
      </ui:FANavigationView.MenuItemTemplate>
      <!-- Account area: one row that shares the bottom-bar height of every page
           status bar. It is hosted next to the pane instead of in PaneFooter
           because the FluentAvalonia pane template reserves ~15 DIP below the
           footer, which would leave the row floating above the status bar. -->
      <ui:FANavigationView.PaneFooter>
        <Panel />
      </ui:FANavigationView.PaneFooter>
      <ui:FANavigationView.Header>
        <Grid x:Name="HeaderHost">
          <!-- Ordinary pages: section title plus the site switch. -->
          <Grid x:Name="NavigationHeader" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <TextBlock x:Name="DocumentTitle" FontSize="20"
                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{Binding SiteLabel}" Click="OnToggleSite" Classes="ghost"
                    FontSize="13" FontWeight="Normal"
                    IsEnabled="{Binding !Settings.IsSaving}" ToolTip.Tip="切换 E-Hentai / ExHentai" />
          </Grid>

          <!-- Reader: the only page header. Work title, page state and the
               reading commands; ReaderPage itself starts at the canvas. Below
               the breakpoint the commands drop to their own compact row and
               collapse to icons so nothing is pushed off-screen. -->
          <controls:AdaptiveGrid x:Name="ReaderHeader" Breakpoint="700" ColumnDefinitions="*,Auto"
                                 ColumnSpacing="16" RowSpacing="4" IsVisible="False"
                                 x:DataType="vm:ReaderViewModel">
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <SelectableTextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <SelectableTextBlock Text="{Binding SourceText}" Classes="caption" MaxWidth="280"
                                     TextTrimming="CharacterEllipsis" IsVisible="{Binding HasSourceText}"
                                     ToolTip.Tip="{Binding SourceText}" />
                <SelectableTextBlock Text="{Binding MissingSummary}" Classes="caption" MaxWidth="320"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource AppWarningBrush}"
                                     IsVisible="{Binding MissingSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     ToolTip.Tip="{Binding MissingSummary}" />
              </StackPanel>
            </StackPanel>
            <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="4" VerticalAlignment="Center">
            <StackPanel x:Name="ReaderCommands" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                        AutomationProperties.Name="阅读工具栏">
              <StackPanel.Styles>
                <Style Selector="StackPanel.compact TextBlock.readerCommandLabel">
                  <Setter Property="IsVisible" Value="False" />
                </Style>
              </StackPanel.Styles>
              <ToggleButton Height="32" MinHeight="32" Padding="8,0" FontSize="13" FontWeight="Normal"
                            IsChecked="{Binding IsSingleMode, Mode=OneWay}" Click="OnReaderSingleMode"
                            AutomationProperties.Name="单页" ToolTip.Tip="单页模式">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <ui:FASymbolIcon Symbol="Page" FontSize="20" />
                  <TextBlock Classes="readerCommandLabel" Text="单页" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton Height="32" MinHeight="32" Padding="8,0" FontSize="13" FontWeight="Normal"
                            IsChecked="{Binding IsContinuousMode, Mode=OneWay}" Click="OnReaderContinuousMode"
                            AutomationProperties.Name="连续" ToolTip.Tip="连续模式">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <ui:FASymbolIcon Symbol="Library" FontSize="20" />
                  <TextBlock Classes="readerCommandLabel" Text="连续" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton Height="32" MinHeight="32" Padding="8,0" FontSize="13" FontWeight="Normal"
                            IsChecked="{Binding IsHorizontalMode, Mode=OneWay}" Click="OnReaderHorizontalMode"
                            AutomationProperties.Name="横向" ToolTip.Tip="横向模式">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <ui:FASymbolIcon Symbol="TwoPage" FontSize="20" />
                  <TextBlock Classes="readerCommandLabel" Text="横向" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <ComboBox Width="128" FontSize="13" FontWeight="Normal" Height="32" MinHeight="32" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Reader.FitMode" ItemsSource="{Binding FitOptions}"
                        SelectedItem="{Binding SelectedFit}" ToolTip.Tip="适应方式" AutomationProperties.Name="适应方式">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FitOption">
                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Normal" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Height="32" MinHeight="32" Padding="8,0" FontSize="13" FontWeight="Normal"
                      Click="OnReaderImmersive" AutomationProperties.Name="沉浸" ToolTip.Tip="隐藏导航与页头，Esc 退出">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <ui:FASymbolIcon Symbol="FullScreen" FontSize="20" />
                  <TextBlock Classes="readerCommandLabel" Text="沉浸" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Height="32" MinHeight="32" Padding="8,0" FontSize="13" FontWeight="Normal"
                      Click="OnReaderFullscreen" AutomationProperties.Name="全屏" ToolTip.Tip="全屏（F11）">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <ui:FASymbolIcon Symbol="FullScreenMaximize" FontSize="20" />
                  <TextBlock Classes="readerCommandLabel" Text="全屏" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
            <Button Grid.Column="1" x:Name="ReaderMoreButton" Width="36" Height="32" MinHeight="32" Padding="0"
                    VerticalAlignment="Center" FontSize="13" FontWeight="Normal"
                    AutomationProperties.AutomationId="Reader.More" AutomationProperties.Name="更多阅读选项" ToolTip.Tip="更多阅读选项">
              <ui:FASymbolIcon Symbol="More" FontSize="16" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="左→右" ToggleType="Radio" IsChecked="{Binding !RightToLeft, Mode=OneWay}"
                            IsEnabled="{Binding IsHorizontalMode}" Click="OnReaderLeftToRight"
                            AutomationProperties.AutomationId="Reader.Direction.LeftToRight" ToolTip.Tip="横向连续模式的页面排列" />
                  <MenuItem Header="右→左" ToggleType="Radio" IsChecked="{Binding RightToLeft, Mode=OneWay}"
                            IsEnabled="{Binding IsHorizontalMode}" Click="OnReaderRightToLeft"
                            AutomationProperties.AutomationId="Reader.Direction.RightToLeft" ToolTip.Tip="横向连续模式的页面排列" />
                  <MenuItem Header="背景色" Click="OnReaderBackground" />
                  <Separator />
                  <MenuItem Header="重试本页" Command="{Binding RetryCurrentCommand}"
                            AutomationProperties.AutomationId="Reader.Retry" />
                  <MenuItem Header="快捷键帮助" Click="OnReaderHelp" />
                  <Separator />
                  <MenuItem Header="关闭阅读器" Click="OnReaderClose" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            </Grid>
          </controls:AdaptiveGrid>
        </Grid>
      </ui:FANavigationView.Header>
      <ui:FAFrame x:Name="ContentHost" CacheSize="0" />
    </ui:FANavigationView>

    <!-- Account bar, pinned to the client bottom and sized to the pane. It
         replaces the PaneFooter so the account line and the page status bar
         share one baseline; a transparent background lets the pane's own brush
         show through. -->
    <Border x:Name="AccountBar" VerticalAlignment="Bottom" HorizontalAlignment="Left"
            MinHeight="40" Background="Transparent" IsVisible="False" Padding="16,5"
            IsEnabled="{Binding !Settings.IsSaving}">
      <Grid x:Name="AccountRow" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
            ColumnSpacing="8" VerticalAlignment="Center">
        <SelectableTextBlock Grid.Row="0" Grid.Column="0" Text="{Binding AccountLabel}" Classes="caption" MaxLines="1"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding AccountDetail}" />
        <!-- 图片额度单独一行：放在账号同一行时，侧栏变窄会先截掉尾部的额度数字。
             整行就是刷新按钮，展开态与折叠浮出都有同一个入口。
             按钮只对齐首行；跨两行居中会让未登录时的单行文字看起来上浮。 -->
        <Button Grid.Row="1" Grid.Column="0" Classes="ghost" Padding="0,1" MinHeight="0"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                VerticalAlignment="Center" Background="Transparent"
                Command="{Binding RefreshImageLimitsCommand}"
                IsVisible="{Binding ShowImageLimit}"
                ToolTip.Tip="{Binding ImageLimitDetail}"
                AutomationProperties.Name="刷新图片额度">
          <TextBlock Text="{Binding ImageLimitLabel}" Classes="caption" FontSize="11"
                     Opacity="0.72" TextTrimming="CharacterEllipsis" MaxLines="1" />
        </Button>
        <Button Grid.Row="0" Grid.Column="1" Content="登录" Classes="ghost" FontSize="12"
                Padding="8,2" MinHeight="26" VerticalAlignment="Center"
                Command="{Binding OpenWebLoginCommand}" IsVisible="{Binding !IsSignedIn}" />
        <Button Grid.Row="0" Grid.Column="1" Content="退出" Classes="ghost" FontSize="12"
                Padding="8,2" MinHeight="26" VerticalAlignment="Center"
                Command="{Binding SignOutCommand}" IsVisible="{Binding IsSignedIn}" />
      </Grid>
    </Border>

    <!-- Compact rail: the same account actions behind a flyout so the 48 DIP
         pane still exposes them without a second row. -->
    <Button x:Name="AccountCompactButton" Width="48" Height="40" Padding="0"
            HorizontalAlignment="Left" VerticalAlignment="Bottom" Classes="ghost"
            IsVisible="False" IsEnabled="{Binding !Settings.IsSaving}"
            AutomationProperties.Name="账号" ToolTip.Tip="{Binding AccountLabel}">
      <ui:FASymbolIcon Symbol="Contact" FontSize="18" />
      <Button.Flyout>
        <Flyout Placement="RightEdgeAlignedBottom">
          <StackPanel Spacing="10" Width="248">
            <SelectableTextBlock Text="{Binding AccountLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <StackPanel Spacing="2" IsVisible="{Binding ShowImageLimit}">
              <TextBlock Text="{Binding ImageLimitLabel}" FontSize="12" />
              <SelectableTextBlock Text="{Binding ImageLimitNote}" Classes="caption" Opacity="0.68"
                                   TextWrapping="Wrap" />
            </StackPanel>
            <Button Content="刷新图片额度" Command="{Binding RefreshImageLimitsCommand}"
                    IsVisible="{Binding IsSignedIn}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
            <Button Content="登录账号" Command="{Binding OpenWebLoginCommand}"
                    IsVisible="{Binding !IsSignedIn}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
            <Button Content="退出登录" Command="{Binding SignOutCommand}"
                    IsVisible="{Binding IsSignedIn}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
          </StackPanel>
        </Flyout>
      </Button.Flyout>
    </Button>
    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24"
            Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="16,10" IsVisible="{Binding ShowToast}">
      <SelectableTextBlock Text="{Binding ToastText}" MaxWidth="620" TextWrapping="Wrap" />
    </Border>
    <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Top" IsVisible="{Binding Online.IsBusy}" />
  </Grid>
</Window>
